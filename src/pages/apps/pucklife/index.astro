---
import "@/styles/global.css";
import Meta from "@/layouts/Meta.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import { configProject as config } from "@/data/configProject";

const queryLang = Astro.url.searchParams.get("lang")?.trim().toLowerCase();
const rawLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();

const lang: "en" | "es" =
  queryLang === "en" || queryLang === "es"
    ? queryLang
    : rawLang === "en" || rawLang === "es"
      ? rawLang
      : "en";

Astro.locals.lang = lang;
const isEs = lang === "es";

const pageTitle = isEs
  ? "PuckLife Counter | Contador de vidas para Wear OS"
  : "PuckLife Counter | Wear OS Tabletop Life Counter";

const features = [
  {
    spec: "180°",
    title: isEs ? "Modo 2 jugadores enfrentados" : "Mirrored 2-Player Mode",
    description: isEs
      ? "Coloca tu reloj en el centro de la mesa. El jugador 2 ve su marcador invertido 180° para una lectura natural frente a frente sin mover el reloj."
      : "Place your watch in the center of the table. Player 2 views their score mirrored 180° for natural head-to-head tabletop reading.",
  },
  {
    spec: "HAPTIC",
    title: isEs ? "Selector de iniciativa háptico" : "Haptic Initiative Decider",
    description: isEs
      ? "Tira una moneda o dado virtual con un solo toque. Una ruleta animada con pulsos hápticos desacelerados señala quién inicia la partida."
      : "Decide who goes first with a single tap. An animated dial with decelerating haptic vibrations points to the starting player.",
  },
  {
    spec: "0° / 90°",
    title: isEs ? "Rotación de mesa adaptable" : "Tabletop Orientation Toggle",
    description: isEs
      ? "Alterna la orientación de la pantalla 90° para adaptar la lectura cuando el reloj reposa horizontalmente entre tapetes y mazos."
      : "Rotate the game display 90° to adapt readability when the watch rests horizontally alongside playmats and decks.",
  },
  {
    spec: "AMOLED",
    title: isEs ? "Protección de inactividad y batería" : "Inactivity Protection & Efficiency",
    description: isEs
      ? "Fondo negro puro (#000000) para máxima autonomía en pantallas OLED, con opción para mantener la pantalla activa durante toda la ronda."
      : "True OLED black (#000000) for maximum battery life, plus an optional wake lock toggle to keep the screen on during active rounds.",
  },
];
---

<!doctype html>
<html lang={lang} class="dark" style="color-scheme: dark;">
  <head>
    <Meta title={pageTitle} />
  </head>

  <body class="antialiased bg-[var(--bg-use)] text-[var(--text-use)] min-h-screen flex flex-col justify-between">
    <Header />

    <main class="flex-1 w-full max-w-4xl mx-auto px-6 py-10 md:py-16">
      <nav aria-label="Breadcrumb" class="mb-6">
        <a
          href={`/apps?lang=${lang}`}
          class="inline-flex items-center gap-1.5 py-1 text-sm font-medium text-sky-400 hover:text-sky-300 transition-colors touch-manipulation focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-400"
        >
          <span aria-hidden="true">←</span>
          <span>{isEs ? "Todas las aplicaciones" : "All apps"}</span>
        </a>
      </nav>

      <section class="rounded-2xl border border-white/10 bg-[var(--color-card-bg)]/60 backdrop-blur-md shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08),0_12px_32px_-8px_rgba(0,0,0,0.35)] p-6 md:p-10 mb-12">
        <div class="flex flex-col md:flex-row items-start gap-8">
          <img
            src="/apps/pucklife/icon.png"
            alt={isEs ? "Icono de PuckLife Counter" : "PuckLife Counter icon"}
            width="144"
            height="144"
            loading="eager"
            decoding="async"
            class="w-28 h-28 md:w-36 md:h-36 rounded-3xl shadow-xl border border-white/10 shrink-0"
          />

          <div class="flex-1 min-w-0">
            <div class="inline-flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-widest text-sky-400 mb-3">
              <span translate="no">Wear OS</span>
              <span aria-hidden="true" class="text-slate-500">·</span>
              <span>{isEs ? "Juegos de mesa y TCG" : "Tabletop & TCG Utility"}</span>
              <span aria-hidden="true" class="text-slate-500">·</span>
              <span class="inline-flex items-center gap-1.5 text-emerald-400 normal-case tracking-normal">
                <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-emerald-400" />
                <span>{isEs ? "Prueba interna en Google Play" : "Internal Testing on Google Play"}</span>
              </span>
            </div>

            <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-[-0.025em] leading-[1.08] text-balance mb-4" translate="no">
              PuckLife Counter
            </h1>
            <p class="text-slate-300 text-base md:text-lg max-w-[60ch] leading-relaxed text-pretty">
              {isEs
                ? "Contador de vidas y turnos para tu muñeca o el centro de la mesa. Diseñado para partidas de 1 y 2 jugadores enfrentados, con selector de iniciativa y respuesta háptica."
                : "Tabletop life and turn counter for your wrist or the center of the table. Built for 1-player and mirrored 2-player matches, with an initiative decider and tactile haptics."}
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-4">
              <a
                href={`/apps/pucklife/privacy?lang=${lang}`}
                class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-sky-400 hover:bg-sky-300 active:bg-sky-500 active:scale-[0.98] motion-reduce:transform-none text-slate-950 text-sm font-semibold transition-[background-color,transform] duration-150 ease-out touch-manipulation focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-400"
              >
                <span>{isEs ? "Leer Política de Privacidad" : "Read Privacy Policy"}</span>
                <span aria-hidden="true">→</span>
              </a>
              <span class="text-xs font-mono text-slate-400 px-3 py-2 rounded-lg bg-white/[0.04] border border-white/10">
                {isEs ? "100% sin conexión · Sin rastreadores" : "100% offline · Zero tracking"}
              </span>
            </div>
          </div>
        </div>

        <div class="mt-8 rounded-xl overflow-hidden border border-white/10 shadow-lg bg-slate-950">
          <img
            src="/apps/pucklife/banner.png"
            alt={isEs ? "Vista previa de la interfaz de PuckLife Counter en Wear OS" : "PuckLife Counter interface preview on Wear OS"}
            width="1024"
            height="500"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover"
          />
        </div>
      </section>

      <section class="mb-12" aria-labelledby="features-title">
        <h2 id="features-title" class="text-2xl font-bold text-white tracking-[-0.015em] text-balance mb-6">
          {isEs ? "Diseñado para la mesa de juego" : "Built for the tabletop"}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {features.map((feature) => (
            <div class="border-t border-white/10 pt-5">
              <span class="inline-block text-[11px] font-mono font-semibold tracking-wider text-sky-400 tabular-nums mb-1.5" translate="no">
                {feature.spec}
              </span>
              <h3 class="text-lg font-semibold text-white tracking-[-0.01em] text-balance mb-2">
                {feature.title}
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed text-pretty tabular-nums">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section class="rounded-2xl border border-white/10 bg-[var(--color-card-bg)]/40 p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-[58ch]">
          <h2 class="text-xl font-bold text-white tracking-[-0.015em] text-balance mb-2">
            {isEs ? "Privacidad y funcionamiento local" : "Privacy & local-only operation"}
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed text-pretty mb-3">
            {isEs
              ? "Sin anuncios, sin analíticas y sin cuentas. Todos los puntos de vida, temporizadores y ajustes permanecen exclusivamente en tu reloj."
              : "No ads, no analytics, and no user accounts. All life totals, timers, and preferences stay strictly on your watch."}
          </p>
          <p class="text-sm text-slate-400">
            <span>{isEs ? "Soporte:" : "Support:"} </span>
            <a
              href={`mailto:${config.support.appsEmail}`}
              class="text-sky-400 hover:text-sky-300 font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-400"
              translate="no"
            >
              {config.support.appsEmail}
            </a>
          </p>
        </div>
        <a
          href={`/apps/pucklife/privacy?lang=${lang}`}
          class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl border border-white/15 bg-white/[0.04] hover:bg-white/[0.08] active:scale-[0.98] motion-reduce:transform-none text-white text-sm font-semibold transition-[background-color,transform] duration-150 ease-out touch-manipulation shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-400"
        >
          <span>{isEs ? "Ver Política de Privacidad" : "View Privacy Policy"}</span>
          <span aria-hidden="true">→</span>
        </a>
      </section>
    </main>

    <Footer />
  </body>
</html>
