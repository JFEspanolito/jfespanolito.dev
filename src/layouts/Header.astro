---
import { Image } from "astro:assets";
import logoImg from "@/assets/images/JFLogo.webp";
import { configProject as config } from "@/data/configProject";
import { aboutData as aboutInfo } from "@/data/about";
import { useTranslations } from "@/i18n/ui";
import LanguageSwitch from "@/components/ui/LanguageSwitch";
// import Oneko from "@/components/ui/Oneko.astro";
import hangingImage from "@/assets/hanging.svg";

const contactLinks = ((aboutInfo as any).contact ?? []) as Array<{
  name: string;
  url: string;
  icon: any;
}>;
const socialLinks = ((aboutInfo as any).social ?? []) as Array<{
  name: string;
  url: string;
  icon: any;
}>;
const emailContact = contactLinks.find((contact) => contact.name === "Email");
const emailAddress =
  emailContact?.url.replace(/^mailto:/, "").split("?")[0] ?? "";
const iconContactLinks = contactLinks.filter(
  (contact) => contact.name !== "Email",
);

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang =
  typeof Astro.locals.lang === "string"
    ? Astro.locals.lang.toLowerCase()
    : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es"
    ? cookieLang
    : Astro.url.pathname.startsWith("/en")
      ? "en"
      : localLang === "es"
        ? "es"
        : "en";

const t = useTranslations(lang);

let aboutLan = null;
if (lang === "en") {
  aboutLan = aboutInfo.EN[0];
} else {
  aboutLan = aboutInfo.ES[0];
}

const navLang = lang === "en" ? "EN" : "ES";
const navigation = config.navigation[navLang];
const navItems = [
  navigation.home,
  navigation.bio,
  navigation.experience,
  navigation.projects,
  navigation.certificates,
];
const sendMailHref = t("sendMail").replace("<mail>", emailAddress);
const copiedEmailMessage = t("header.emailCopied");
const emailCopyErrorMessage = t("header.emailCopyError");
const emailActionTitle = t("header.emailCopyAndSend");
const sendMailLabel = lang === "en" ? "Send Mail" : "Enviar correo";
const copyMailLabel = lang === "en" ? "Copy Mail" : "Copiar correo";
---

<header
  id="main-header"
  class="sticky top-0 z-40 w-full bg-[var(--bg-dark)]/90 backdrop-blur-sm shadow-[0_1px_0_rgba(242,201,76,0.16)] text-2xl"
>
  <div class="container mx-auto max-w-7xl px-4">
    <div class="flex items-center justify-between h-12">
      <a
        href="/"
        class="flex items-center gap-3"
        title={`${aboutLan.callToAction}`}
      >
        <Image
          src={logoImg}
          alt={`${config.appName} logo`}
          class="w-6 h-6"
          width={24}
          height={24}
          loading="eager"
          decoding="async"
        />
        <span class="sm:inline font-semibold text-x text-[var(--color-green)]"
          >{config.appName}</span
        >
      </a>

      <div class="ml-auto flex items-center justify-end">
        <!-- <div class="hidden md:flex h-8 items-center gap-2 border-r border-[var(--color-resaltar)] mr-4 ml-4 pr-4">
          <Oneko client:load />
        </div> -->
        <div
          class="hidden md:flex h-8 items-center gap-2 border-r border-[var(--color-resaltar)] px-4"
        >
          <LanguageSwitch client:load initialLang={lang} />
        </div>

        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-md border border-[var(--color-resaltar)]/40 text-[var(--color-resaltar)] hover:bg-white/5 active:scale-95 transition-all"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
          aria-label="Abrir menú"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <div
          class="hidden md:flex h-8 items-center gap-2 border-r border-[var(--color-resaltar)] px-4"
        >
          {
            iconContactLinks.map((contact) => (
              <a
                class="scale-80 hover:scale-120 p-2 rounded-md"
                href={contact.url}
                title={contact.name}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${contact.name}`}
              >
                <Image
                  class="w-8 h-8"
                  src={contact.icon}
                  alt={`${contact.name} icon`}
                  width={32}
                  height={32}
                  loading="eager"
                  decoding="async"
                />
              </a>
            ))
          }
        </div>

        {
          emailContact && (
            <div class="group relative hidden lg:flex h-8 items-center border-r border-[var(--color-resaltar)] px-4">
              <button
                class="flex items-center gap-2 rounded-md p-2 text-sm text-[var(--text-use)] hover:text-[var(--color-green)] transition-colors"
                type="button"
                title={emailActionTitle}
                aria-label={emailActionTitle}
                aria-haspopup="true"
              >
                <Image
                  class="w-8 h-8 flex-shrink-0"
                  src={emailContact.icon}
                  alt="Email icon"
                  width={32}
                  height={32}
                  loading="eager"
                  decoding="async"
                />
                <span class="max-w-[220px] truncate">{emailAddress}</span>
              </button>

              <div
                class="pointer-events-none absolute right-4 top-[calc(100%-1px)] z-50 w-44 translate-y-1 rounded-2xl border border-[var(--color-resaltar)]/30 bg-[var(--bg-dark)]/95 p-2 text-sm opacity-0 shadow-2xl backdrop-blur-md transition-all duration-150 group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100"
                role="menu"
                aria-label={emailActionTitle}
              >
                <a
                  class="block rounded-xl px-3 py-2 text-[var(--text-use)] transition-colors hover:bg-white/10 hover:text-[var(--color-green)] focus:bg-white/10 focus:text-[var(--color-green)] focus:outline-none"
                  href={sendMailHref}
                  role="menuitem"
                >
                  {sendMailLabel}
                </a>
                <button
                  id="header-email-copy-button"
                  class="mt-1 w-full rounded-xl px-3 py-2 text-left text-[var(--text-use)] transition-colors hover:bg-white/10 hover:text-[var(--color-green)] focus:bg-white/10 focus:text-[var(--color-green)] focus:outline-none"
                  type="button"
                  role="menuitem"
                  data-header-email-copy="true"
                  data-email-address={emailAddress}
                  data-copied-message={copiedEmailMessage}
                  data-copy-error-message={emailCopyErrorMessage}
                >
                  {copyMailLabel}
                </button>
              </div>
            </div>
          )
        }

        <div
          class="hidden md:flex h-8 items-center gap-2 border-r border-[var(--color-resaltar)] px-4"
        >
          {
            socialLinks.map((contact) => (
              <a
                class="scale-80 hover:scale-120 p-2 rounded-md"
                href={contact.url}
                title={`${contact.url}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${contact.url}`}
              >
                <Image
                  class="w-8 h-8"
                  src={contact.icon}
                  alt={`${contact.name} icon`}
                  width={32}
                  height={32}
                  loading="eager"
                  decoding="async"
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      id="bannerClic"
      class="absolute hidden md:right-170 top-full mt-2 flex flex-col items-center group"
    >
      <Image
        src={hangingImage}
        alt="Hanging"
        class="w-16 h-16 md:w-64 md:h-32"
      />
      <span
        class="absolute top-3/5 -translate-y-1/2 text-sm md:text-base font-semibold text-[var(--text-use)]"
      >
        {lang === "es" ? "Escríbeme" : "Write me"}
      </span>
    </div>
  </div>

  <div
    id="mobile-menu-panel"
    class="md:hidden hidden border-t border-[var(--color-resaltar)]/20 bg-[var(--bg-dark)]/98 backdrop-blur-md px-4 py-6 shadow-2xl max-h-[calc(100vh-4rem)] overflow-y-auto"
  >
    <nav class="flex flex-col gap-2" aria-label="Mobile navigation">
      <div
        class="flex items-center justify-between mb-2 pb-2 border-b border-[var(--color-resaltar)]/10"
      >
        <span class="text-sm font-medium text-[var(--text-use)]/60"
          >Idioma / Language</span
        >
        <LanguageSwitch client:load initialLang={lang} />
      </div>
      {
        navItems.map((item) => (
          <a
            class="menu-link rounded-md px-3 py-2 text-base text-[var(--text-use)] hover:bg-white/5"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
      <div
        class="mt-4 pt-4 border-t border-[var(--color-resaltar)]/10 flex flex-wrap gap-4 justify-center"
      >
        {
          contactLinks.map((contact) => (
            <a
              class="p-2 rounded-md hover:bg-white/5"
              href={contact.url}
              title={`${contact.name}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${contact.name}`}
            >
              <Image
                class="w-6 h-6"
                src={contact.icon}
                alt={`${contact.name} icon`}
                width={24}
                height={24}
              />
            </a>
          ))
        }
        {
          socialLinks.map((contact) => (
            <a
              class="p-2 rounded-md hover:bg-white/5"
              href={contact.url}
              title={`${contact.name}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${contact.name}`}
            >
              <Image
                class="w-6 h-6"
                src={contact.icon}
                alt={`${contact.name} icon`}
                width={24}
                height={24}
              />
            </a>
          ))
        }
      </div>
    </nav>
  </div>

  <script>
    const SILEO_NOTIFICATION_TYPE = {
      SUCCESS: "success",
      ERROR: "error",
    } as const;

    type SileoNotificationType =
      (typeof SILEO_NOTIFICATION_TYPE)[keyof typeof SILEO_NOTIFICATION_TYPE];

    async function copyEmailToClipboard(emailAddress: string) {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(emailAddress);
          return;
        } catch {
          // Fall back to the legacy copy path below.
        }
      }

      const input = document.createElement("textarea");
      input.value = emailAddress;
      input.setAttribute("readonly", "true");
      input.style.position = "absolute";
      input.style.left = "-9999px";
      document.body.appendChild(input);
      input.select();
      document.execCommand("copy");
      document.body.removeChild(input);
    }

    let isMenuListenerAdded = false;

    function initMenu() {
      const menuBtn = document.querySelector("#mobile-menu-btn");
      const menuPanel = document.querySelector("#mobile-menu-panel");

      if (!menuBtn || !menuPanel) return;

      const toggleMenu = (e: Event) => {
        e.stopPropagation();
        const isHidden = menuPanel.classList.toggle("hidden");
        menuBtn.setAttribute("aria-expanded", String(!isHidden));
      };

      menuBtn.removeEventListener("click", toggleMenu);
      menuBtn.addEventListener("click", toggleMenu);

      const navLinks = menuPanel.querySelectorAll("a");
      navLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          const href = link.getAttribute("href");

          if (href && href.startsWith("#")) {
            e.preventDefault();
            const targetId = href.substring(1);
            const targetEl = document.getElementById(targetId);

            if (targetEl) {
              const container = document.getElementById(
                "main-scroll-container",
              );

              if (container) {
                // Precise scroll using the container
                container.scrollTo({
                  top: targetEl.offsetTop,
                  behavior: "smooth",
                });
              } else {
                // Fallback
                targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
              }

              // Reset internal scrollable areas for specific sections
              setTimeout(() => {
                const internal = targetEl.querySelector(
                  ".overflow-y-auto, [data-experience-scroll], #experience-content",
                );
                if (internal && internal instanceof HTMLElement) {
                  internal.scrollTo({ top: 0, behavior: "smooth" });
                }
              }, 400);

              // Update URL without jump
              history.pushState(null, "", href);
            }
          }

          menuPanel.classList.add("hidden");
          menuBtn.setAttribute("aria-expanded", "false");
        });
      });

      if (!isMenuListenerAdded) {
        document.addEventListener("click", (event: MouseEvent) => {
          const target = event.target as Node;
          const isClickInsideMenu = menuPanel.contains(target);
          const isClickOnButton = menuBtn.contains(target);

          if (
            !isClickInsideMenu &&
            !isClickOnButton &&
            !menuPanel.classList.contains("hidden")
          ) {
            menuPanel.classList.add("hidden");
            menuBtn.setAttribute("aria-expanded", "false");
          }
        });
        isMenuListenerAdded = true;
      }
    }

    initMenu();
    document.addEventListener("astro:page-load", initMenu);

    function showEmailCopiedFeedback(
      type: SileoNotificationType,
      message: string,
    ) {
      document.dispatchEvent(
        new CustomEvent("sileo:notify", {
          detail: {
            type,
            title: message,
            description: "",
          },
        }),
      );
    }

    let isEmailCopyListenerAdded = false;

    function initEmailCopyButton() {
      if (isEmailCopyListenerAdded) return;

      document.addEventListener("click", async (event) => {
        const target = event.target;
        const targetElement =
          target instanceof Element
            ? target
            : target instanceof Node
              ? target.parentElement
              : null;
        const emailCopyButton = targetElement?.closest(
          "[data-header-email-copy='true']",
        );

        if (!(emailCopyButton instanceof HTMLButtonElement)) return;
        event.preventDefault();

        const emailAddress = emailCopyButton.dataset.emailAddress ?? "";
        const copiedMessage =
          emailCopyButton.dataset.copiedMessage ?? "Correo copiado";
        const copyErrorMessage =
          emailCopyButton.dataset.copyErrorMessage ??
          "No se pudo copiar el correo";

        try {
          await copyEmailToClipboard(emailAddress);
          showEmailCopiedFeedback(
            SILEO_NOTIFICATION_TYPE.SUCCESS,
            copiedMessage,
          );
        } catch {
          showEmailCopiedFeedback(
            SILEO_NOTIFICATION_TYPE.ERROR,
            copyErrorMessage,
          );
        }
      });

      isEmailCopyListenerAdded = true;
    }

    initEmailCopyButton();
    document.addEventListener("astro:page-load", initEmailCopyButton);

    function initBanner() {
      const bannerClic = document.querySelector("#bannerClic");
      let bannerTimer: ReturnType<typeof setTimeout> | null = null;

      const handleBanner = () => {
        if (!(bannerClic instanceof HTMLElement)) return;
        bannerClic.classList.remove("hidden");
        if (bannerTimer) clearTimeout(bannerTimer);
        bannerTimer = setTimeout(() => {
          bannerClic.classList.add("hidden");
        }, 8000);
      };

      window.removeEventListener("show-header-banner-click", handleBanner);
      window.addEventListener("show-header-banner-click", handleBanner);
    }

    initBanner();
    document.addEventListener("astro:page-load", initBanner);
  </script>
</header>
