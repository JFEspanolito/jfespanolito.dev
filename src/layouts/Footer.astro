---
import { Image } from "astro:assets";
import githubLogo from "@/assets/logos/github.svg";
import { configProject } from "@/data/configProject";

const year = new Date().getFullYear();

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang =
  typeof Astro.locals.lang === "string"
    ? Astro.locals.lang.toLowerCase()
    : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es"
    ? cookieLang
    : Astro.url.pathname.startsWith("/en")
      ? "en"
      : localLang === "es"
        ? "es"
        : "en";

const copyright =
  lang === "en"
    ? `© ${year} Jorge A. Falcón A. — Web code is public. Apps, products, and personal info: all rights reserved.`
    : configProject.copyright;
---

<footer
  class="flex flex-col sm:flex-row items-center justify-center gap-3 py-8 px-6 text-xs md:text-sm text-slate-400 border-t border-white/[0.08]"
>
  <a
    class="p-1 rounded-md text-slate-400 hover:text-white transition-all hover:scale-105"
    href="https://github.com/JFEspanolito/jfespanolito.dev"
    title="GitHub"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub"
  >
    <Image
      class="w-5 h-5 opacity-70 hover:opacity-100 transition-opacity"
      src={githubLogo}
      alt="GitHub icon"
      width={20}
      height={20}
      loading="lazy"
      decoding="async"
    />
  </a>
  <p class="text-center">
    {copyright}
  </p>
</footer>
