---
import { Image } from "astro:assets";
import githubLogo from "@/assets/logos/github.svg";
import { configProject } from "@/data/configProject";

const year = new Date().getFullYear();

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang =
  typeof Astro.locals.lang === "string"
    ? Astro.locals.lang.toLowerCase()
    : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es"
    ? cookieLang
    : Astro.url.pathname.startsWith("/en")
      ? "en"
      : localLang === "es"
        ? "es"
        : "en";

const copyright =
  lang === "en"
    ? `© ${year} — The source code for this site is public and may be reviewed and reused. The personal and professional information presented is not authorized for copy or redistribution.`
    : configProject.copyright;
---

<footer
  class="flex items-center justify-center font-sans text-[var(--color-green)]"
>
  <a
    class="scale-80 hover:scale-120 p-2 rounded-md"
    href="https://github.com/JFEspanolito/jfespanolito.dev"
    title="GitHub"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub"
  >
    <Image
      class="w-32 h-32 md:w-8 md:h-8"
      src={githubLogo}
      alt="GitHub icon"
      width={32}
      height={32}
      loading="eager"
      decoding="async"
    />
  </a>
  <p class="text-sm md:text-base opacity-80 text-center md:text-right">
    {copyright}
  </p>
</footer>
