---
// Importando Estilos
import "@/styles/global.css";
import { Toaster } from "sileo";
import "sileo/styles.css";

// Importando Datos
import { configProject as config } from "@/data/configProject";

// Importando Componentes
import Meta from "./Meta.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import VerticalMenu from "@/components/sections/VerticalMenu.astro";

const queryLang = Astro.url.searchParams.get("lang")?.trim().toLowerCase();
const rawLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();

const lang: "en" | "es" =
  queryLang === "en" || queryLang === "es"
    ? queryLang
    : rawLang === "en" || rawLang === "es"
      ? rawLang
      : Astro.url.pathname.startsWith("/en")
        ? "en"
        : "en";

if (queryLang === "en" || queryLang === "es") {
  Astro.cookies.set("lang", queryLang, {
    path: "/",
    maxAge: 60 * 60 * 24 * 365,
    sameSite: "lax",
  });
}

Astro.locals.lang = lang;

// Propiedades
interface Props {
  title?: string;
}

const { title } = Astro.props;
// Lógica para que el título sea "Página | AppName" o solo "AppName"
const finalTitle = title ? `${title}` : config.appName;
---

<!doctype html>
<html lang={lang} class="dark" style="color-scheme: dark;">
  <head>
    <Meta title={finalTitle} />
  </head>

  <body class="antialiased bg-[var(--bg-use)] text-[var(--text-use)] h-screen flex flex-col overflow-hidden">
    {/* Componente de notificaciones globales */}
    <Toaster client:load position="top-center" />

    <Header />

    <main class="flex-1 flex overflow-hidden min-h-0 w-full">
      <!-- <aside class="hidden md:flex items-center ml-80 -mr-80"> -->
      <aside class="hidden md:flex items-center w-[360px] justify-end">
        <VerticalMenu />
      </aside>

      <div
        id="main-scroll-container"
        class="flex-1 h-full min-h-0 overflow-y-scroll snap-y snap-mandatory scroll-smooth py-6 px-4 md:pr-8 no-scrollbar"
      >
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
