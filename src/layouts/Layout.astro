---
// Importando Estilos
import "@/styles/global.css";
import { Toaster } from "sileo";
import "sileo/styles.css";

// Importando Datos
import { configProject as config } from "@/data/configProject";

// Importando Componentes
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import VerticalMenu from "@/components/sections/VerticalMenu.astro";

const queryLang = Astro.url.searchParams.get("lang")?.trim().toLowerCase();
const rawLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();

const lang: "en" | "es" =
  queryLang === "en" || queryLang === "es"
    ? queryLang
    : rawLang === "en" || rawLang === "es"
      ? rawLang
      : Astro.url.pathname.startsWith("/en")
        ? "en"
        : "es";

if (queryLang === "en" || queryLang === "es") {
  Astro.cookies.set("lang", queryLang, {
    path: "/",
    maxAge: 60 * 60 * 24 * 365,
    sameSite: "lax",
  });
}

Astro.locals.lang = lang;

// Propiedades
interface Props {
  title?: string;
}

const { title } = Astro.props;
// Lógica para que el título sea "Página | AppName" o solo "AppName"
const finalTitle = title ? `${title}` : config.appName;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Aquí usamos tu variable calculada */}
    <title>{finalTitle}</title>

    {/* Meta tags globales desde tu config */}
    <meta name="description" content={config.appDescription} />
    <meta name="theme-color" content={config.themeColor} />
    <meta name="generator" content={Astro.generator} />

    {/* Open Graph / Facebook */}
    <meta property="og:url" content={config.siteUrl + "/"} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={config.appDescription} />
    <meta property="og:image" content={config.siteUrl + config.images.ogDefault} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={config.domainName} />
    <meta property="twitter:url" content={config.siteUrl + "/"} />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={config.appDescription} />
    <meta name="twitter:image" content={config.siteUrl + config.images.twitterCard} />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  </head>

  <body class="antialiased bg-[var(--bg-use)] text-[var(--text-use)] h-screen flex flex-col overflow-hidden">
    {/* Componente de notificaciones globales */}
    <Toaster client:load position="top-center" />

    <Header />

    <main class="flex-1 flex overflow-hidden min-h-0 w-full">
      <!-- <aside class="hidden md:flex items-center ml-80 -mr-80"> -->
      <aside class="hidden md:flex items-center w-[360px] justify-end">
        <VerticalMenu />
      </aside>

      <div
        id="main-scroll-container"
        class="flex-1 h-full min-h-0 overflow-y-scroll snap-y snap-mandatory scroll-smooth py-6 px-4 md:pr-8 no-scrollbar"
      >
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
