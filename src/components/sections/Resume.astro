---
import { Image } from "astro:assets";
import { aboutData, yearsOfExperience } from "@/data/about";
import { projectsData } from "@/data/projects";
import { experienceData } from "@/data/experience";
import { certificatesData } from "@/data/certificates";
import { useTranslations } from "@/i18n/ui";
import techBanner from "@/assets/techBanner.webp";
import heyListenAudio from "@/assets/audio/hey_listen.webm";
import { CtaButton } from "@/components/ui/CtaButton";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "es" ? "es" : "en";

const t = useTranslations(lang);

let projects = null;
let experiences = null;
let profileInfo = null;
let certificates = null;

if (lang === "en") {
  profileInfo = aboutData.EN[0];
  projects = projectsData.EN;
  experiences = experienceData.EN;
  certificates = certificatesData.EN;
} else {
  profileInfo = aboutData.ES[0];
  projects = projectsData.ES;
  experiences = experienceData.ES;
  certificates = certificatesData.ES;
}

// Lógica para KPIs dinámicos
const totalRobots = "35+";
const impactValue = lang === "en" ? "+$165k USD" : "+$3MDP";
const lastJob = experiences[0];
const lastJobSkills = lastJob.topskills.slice(0, 5);
const projectSkills = projects.flatMap((p) => p.topskills);
const topSkills = [...new Set([...lastJobSkills, ...projectSkills])];
const recentCerts = certificates.slice(0, 4);
// const emailAddress = aboutData.contact.find((c) => c.name === "Email")?.url.replace(/^mailto:/, "").split("?")[0] ?? "";
// const sendMailHref = t("sendMail").replace("<mail>", emailAddress);

const contactInfo = [
  {
    name: "LinkedIn",
    url: aboutData.contact.find((c) => c.name === "LinkedIn")?.url,
    icon: aboutData.contact.find((c) => c.name === "LinkedIn")?.icon,
    desc: lang === "en" ? "Professional profile and updates" : "Perfil profesional y actualizaciones",
    label: lang === "en" ? "View Profile" : "Ver Perfil",
    color: "var(--color-linkedin)",
    iconSymbol: "arrow_outward",
  },
  {
    name: "Telegram",
    url: aboutData.contact.find((c) => c.name === "Telegram")?.url,
    icon: aboutData.contact.find((c) => c.name === "Telegram")?.icon,
    desc: lang === "en" ? "Direct chat and quick responses" : "Chat directo y respuestas rápidas",
    label: lang === "en" ? "Start Chat" : "Iniciar Chat",
    color: "var(--color-telegram)",
    iconSymbol: "send",
  },
  {
    name: "Email",
    url: aboutData.contact.find((c) => c.name === "Email")?.url,
    icon: aboutData.contact.find((c) => c.name === "Email")?.icon,
    desc: lang === "en" ? "Formal inquiries and proposals" : "Consultas y propuestas formales",
    label: lang === "en" ? "Send Email" : "Enviar Correo",
    color: "var(--color-email)",
    iconSymbol: "forward_to_inbox",
  },
];

const emailAddress =
  aboutData.contact
    .find((c) => c.name === "Email")
    ?.url.replace(/^mailto:/, "")
    .split("?")[0] ?? "";
const sendMailHref = t("sendMail").replace("<mail>", emailAddress);
const copiedEmailMessage = t("header.emailCopied");
const emailCopyErrorMessage = t("header.emailCopyError");
---

<section id="Resumen" class="w-full flex flex-col px-4 py-10 md:px-6 md:py-12 lg:px-8 lg:py-0">
  <div class="relative w-full max-w-7xl mx-auto min-h-screen flex flex-col justify-center gap-10 py-10 lg:py-14">
    {/* Call to Action */}
    <div class="flex flex-col gap-4 items-center justify-center text-center w-full">
      <div class="max-w-5xl mx-auto w-full">
        <CtaButton
          client:idle
          audioSrc={heyListenAudio}
          propType="success"
          propFill="var(--color-card-bg )"
          buttonClic={{
            title: lang === "en" ? "Email" : "Correo",
            url: sendMailHref,
            copyValue: emailAddress,
          }}
          propDesc={lang === "en" ? "Send me a mail or use other social media" : "Envíame un correo o usa otra red social"}
          propTitle={profileInfo.callToAction}
        />
      </div>
    </div>

    {/* Resume  */}
    <div class="grid grid-cols-12 gap-6 lg:gap-8 items-start w-full">
      <div class="col-span-12 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-5 w-full">
        {/* Metrics */}
        <div
          class="group rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5 flex flex-col justify-center items-center text-center backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05]"
        >
          <span class="text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-1.5">{impactValue}</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-green)] opacity-90">{lang === "en" ? "Annual Impact" : "Impacto Anual"}</span>
        </div>

        <div
          class="group rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5 flex flex-col justify-center items-center text-center backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05]"
        >
          <span class="text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-1.5">{totalRobots}</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-green)] opacity-90">{lang === "en" ? "Live Robots" : "Robots en Prod"}</span>
        </div>

        <div
          class="group rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5 flex flex-col justify-center items-center text-center backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05]"
        >
          <span class="text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-1.5">+{yearsOfExperience}</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-green)] opacity-90">{lang === "en" ? "Years Exp." : "Años Exp."}</span>
        </div>

        <div
          class="group rounded-2xl border border-white/[0.08] bg-white/[0.02] p-5 flex flex-col justify-center text-center items-center backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.05]"
        >
          <span class="text-3xl lg:text-4xl font-extrabold tracking-tight text-white mb-1.5">{profileInfo.sc}</span>
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-green)] opacity-90 leading-snug">{profileInfo.Major}</span>
        </div>

        {/* Headline */}
        <div class="col-span-2 md:col-span-4 mt-6 flex justify-center">
          <p class="max-w-3xl text-balance text-center text-xl lg:text-2xl leading-relaxed text-slate-100 font-medium tracking-tight">
            {profileInfo.headline}
          </p>
        </div>

        {/* Stack */}
        <div
          class="relative overflow-hidden col-span-2 md:col-span-4 mt-4 rounded-2xl border border-white/[0.08] bg-white/[0.02] px-4 py-6 md:px-8 md:py-7 text-center backdrop-blur-sm"
        >
          <div class="relative z-10">
            <h4
              class="text-xs font-semibold uppercase mb-4 text-[var(--color-green)] tracking-[0.2em] opacity-90"
            >
              {lang === "en" ? "Strategic Stack" : "Stack Tecnológico"}
            </h4>
            <div class="flex flex-wrap gap-2.5 justify-center">
              {
                topSkills.map((skill) => (
                  <span class="px-3.5 py-1.5 bg-white/[0.05] rounded-full text-xs font-medium text-slate-200 border border-white/[0.08] whitespace-nowrap backdrop-blur-md transition-all duration-200 hover:border-white/25 hover:text-white hover:bg-white/[0.1]">
                    {skill}
                  </span>
                ))
              }
            </div>
          </div>
        </div>

        {/* Certifications */}
        <div class="col-span-2 md:col-span-4 mt-2">
          <div class="rounded-2xl p-4 md:p-6 w-full">
            <div class="mb-4 text-center">
              <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-green)] opacity-90">
                {lang === "en" ? "Recent Certifications" : "Certificaciones Recientes"}
              </h2>
            </div>
            <div class="grid grid-cols-1 gap-3 xl:grid-cols-2 xl:gap-x-6 xl:gap-y-3">
              {
                recentCerts.map((cert) => (
                  <div class="flex items-start gap-3 rounded-xl border border-transparent px-3.5 py-2.5 transition-colors hover:border-white/10 hover:bg-white/[0.03]">
                    <div class="mt-2 h-1.5 w-1.5 bg-[var(--color-green)] rounded-full flex-shrink-0" />
                    <span class="text-sm lg:text-base leading-relaxed text-slate-200 text-left break-words text-pretty">
                      {cert.name}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Conectemos Section -->
    <div class="mt-16 border-t border-white/[0.08] pt-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {
          contactInfo.map((contact) => (
            <div class="group relative flex h-full flex-col items-center rounded-2xl border border-white/[0.08] bg-white/[0.02] p-8 text-center backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04]">
              <div
                class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5 group-hover:scale-105 transition-transform duration-300"
                style={`background-color: ${contact.color}15`}
              >
                <Image
                  src={contact.icon as any}
                  alt={contact.name}
                  class="w-8 h-8 opacity-90 group-hover:opacity-100 object-contain"
                  width={32}
                  height={32}
                />
              </div>

              <h4 class="text-lg font-bold text-white mb-1.5 transition-colors">{contact.name}</h4>
              <p class="text-xs text-slate-400 mb-6 leading-relaxed">{contact.desc}</p>

              <a
                href={contact.name === "Email" ? sendMailHref : contact.url}
                target={contact.name === "Email" ? undefined : "_blank"}
                rel={contact.name === "Email" ? undefined : "noopener noreferrer"}
                class:list={["cta contact-cta mt-auto flex items-center gap-2", contact.name === "Email" && "contact-cta--email"]}
              >
                {contact.label}
                <span class="material-symbols-outlined text-sm">{contact.iconSymbol}</span>
              </a>

              <div class="mt-2 flex min-h-[3.25rem] w-full items-center justify-center">
                {contact.name === "Email" ? (
                  <p
                    class="flex w-full max-w-full items-center justify-center gap-2 rounded-xl px-3 py-1.5 text-center cursor-copy break-all text-xs font-medium text-slate-400 transition-colors hover:text-white"
                    data-email-copy="true"
                    data-email-address={emailAddress}
                    data-copied-message={copiedEmailMessage}
                    data-copy-error-message={emailCopyErrorMessage}
                    title={lang === "en" ? "Click to copy email" : "Haz clic para copiar el correo"}
                  >
                    <span class="material-symbols-outlined shrink-0 text-sm text-[var(--color-red)]">content_copy</span>
                    <span class="min-w-0 break-all">{emailAddress}</span>
                  </p>
                ) : (
                  <span class="sr-only">placeholder</span>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-cta--email {
    background: var(--color-red);
    border-color: color-mix(in srgb, var(--color-red) 45%, transparent);
    color: white;
  }

  .contact-cta--email:hover {
    background: color-mix(in srgb, var(--color-red) 88%, black);
    border-color: color-mix(in srgb, var(--color-red) 60%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-red) 28%, transparent);
  }
</style>
