---
import { Image } from "astro:assets";
import { certificatesData } from "@/data/certificates";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "en" ? "en" : "es";

let certificates = null;
if (lang === "en") {
  certificates = certificatesData.EN;
} else {
  certificates = certificatesData.ES;
}

const featured = certificates?.[0] ?? null;
const restCertificates = certificates?.slice(1) ?? [];

const title = lang === "en" ? "Achievements · Certificates" : "Logros · Certificados";
const issuerLabel = lang === "en" ? "Issuer" : "Entidad";
const totalCertLabel = lang === "en" ? "Total Certifications" : "Total Certificaciones";

const totalCertifications = certificates?.length ?? 0;

function formatDate(value: string) {
  try {
    return new Date(value).toLocaleDateString(lang === "en" ? "en-US" : "es-MX", {
      year: "numeric",
      month: "short",
    });
  } catch {
    return value;
  }
}

function issuerFromUrl(url: string) {
  if (!url) return lang === "en" ? "Unknown" : "Sin dato";
  try {
    const host = new URL(url).hostname.replace("www.", "");
    return host;
  } catch {
    return url;
  }
}
---

<section id="Certificados" class="min-h-full w-full overflow-y-auto no-scrollbar">
  <div class="w-full max-w-7xl mx-auto px-4 md:px-6 lg:px-8 py-12 md:py-16">
    {/* Titulo */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6 md:mb-12">
      <div class="col-span-2 p-8 rounded-3xl relative overflow-hidden group">
        <h2 class="text-4xl md:text-5xl font-bold text-[var(--color-green)] py-2">
          {title}
        </h2>
      </div>
      <div
        class="experience-card p-6 rounded-3xl flex flex-col items-center justify-center text-center max-w-[12rem] mx-auto lg:mx-0 lg:justify-self-end"
      >
        <span class="text-4xl font-bold text-[var(--color-resaltar)] mb-1">{totalCertifications}+</span>
        <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--color-blue)] font-black">{totalCertLabel}</span>
      </div>
    </div>

    {/* Certificado Principal */}
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-16">
      <div class="col-span-1 group"></div>
      <div class="col-span-2 experience-card p-8 rounded-3xl relative overflow-hidden group">
        {
          featured && (
            <div class="relative z-10">
              <button
                type="button"
                class="mb-5 w-full rounded-2xl overflow-hidden border border-white/10 bg-black/10 cursor-zoom-in"
                data-cert-preview
                data-preview-src={featured.img.src}
                data-preview-alt={featured.name}
                aria-label={`Ver certificado: ${featured.name}`}
              >
                <Image src={featured.img} alt={featured.name} class="w-full h-auto" width={900} height={520} />
              </button>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="md:col-span-2">
                  <h3 class="text-2xl md:text-3xl font-bold text-[var(--color-blue)] mb-4 break-words leading-tight">{featured.name}</h3>
                  <p class="text-base mb-6 max-w-2xl leading-relaxed border-l-2 border-[var(--color-resaltar)] pl-4 break-words">
                    {featured.resume}
                  </p>
                </div>
                <div>
                  <div>
                    <p class="text-base uppercase font-bold tracking-widest mb-1 text-[var(--color-purple)]">{issuerLabel}</p>
                    <a
                      class="underline ml-6 text-[var(--color-red)] inline-block max-w-full truncate align-middle"
                      href={featured.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {issuerFromUrl(featured.url)}
                    </a>
                    <p class="text-base mt-10 uppercase tracking-wide text-[var(--color-resaltar)] font-bold">
                      {formatDate(featured.date)}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          )
        }
      </div>
      <div class="col-span-1 group"></div>
    </div>

    {/* Certificados list */}
    <div class="max-h-[34rem] overflow-y-auto no-scrollbar pr-1">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          restCertificates.map((cert) => (
            <div class="experience-card p-2 rounded-2xl group overflow-hidden">
              <a
                href={cert.url || "#"}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block max-w-full cursor-pointer align-middle "
              >
                <div class="flex items-center gap-4 min-w-0 w-full">
                  <div class="w-12 h-12 rounded-xl bg-[var(--bg-dark)] flex items-center justify-center border border-white/5">
                    <Image src={cert.img} alt={cert.name} width={48} height={48} class="w-full h-full object-cover" />
                  </div>

                  <div class="min-w-0 w-full grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-2 items-start">
                    <div class="min-w-0">
                      <h4 class="text-lg md:text-xl font-bold text-[var(--color-blue)] group-hover:text-[var(--color-resaltar)] transition-colors truncate">
                        {cert.name}
                      </h4>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {/* Modal de vista ampliada de certificado*/}
  <div
    id="cert-lightbox"
    class="fixed inset-0 z-[120] hidden items-center justify-center bg-[var(--bg-dark)]/90 p-4 md:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Vista ampliada de certificado"
  >
    <button
      id="cert-lightbox-close"
      type="button"
      class="absolute top-4 right-4 md:top-6 md:right-6 h-10 w-10 rounded-full border border-white/20 text-[var(--text-use)] hover:border-[var(--color-resaltar)]"
      aria-label="Cerrar"
    >
      ✕
    </button>

    <img
      id="cert-lightbox-image"
      src=""
      alt=""
      class="max-h-[90vh] max-w-[95vw] w-auto h-auto rounded-xl border border-white/15 shadow-2xl"
    />
  </div>
</section>

<script>
  const lightbox = document.getElementById("cert-lightbox");
  const lightboxImg = document.getElementById("cert-lightbox-image") as HTMLImageElement | null;
  const closeBtn = document.getElementById("cert-lightbox-close");
  const previewButtons = document.querySelectorAll("[data-cert-preview]");

  function openLightbox(src: string | null, alt: string | null) {
    if (!lightbox || !lightboxImg || !src) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt || "Certificate preview";
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    lightboxImg.src = "";
    lightboxImg.alt = "";
  }

  previewButtons.forEach((button) => {
    button.addEventListener("click", () => {
      openLightbox(button.getAttribute("data-preview-src"), button.getAttribute("data-preview-alt"));
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeLightbox();
  });
</script>
