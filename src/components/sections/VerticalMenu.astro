---
import { aboutData } from "@/data/about";
import bgRight from "@/assets/images/bg_right.webp";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "en" ? "en" : "es";

let profileInfo = null;
if (lang === "en") {
  profileInfo = aboutData.EN[0];
} else {
  profileInfo = aboutData.ES[0];
}

const navItems =
  lang === "en"
    ? [
        { label: "🕹️ Home", href: "#Resumen" },
        { label: "📜 Bio", href: "#Bio" },
        { label: "💼 Experience", href: "#Experiencia" },
        { label: "🛠️ Projects", href: "#Proyectos" },
        { label: "🏅 Certificates", href: "#Certificados" },
      ]
    : [
        { label: "🕹️ Inicio", href: "#Resumen" },
        { label: "📜 Bio", href: "#Bio" },
        { label: "💼 Experiencia", href: "#Experiencia" },
        { label: "🛠️ Proyectos", href: "#Proyectos" },
        { label: "🏅 Certificados", href: "#Certificados" },
      ];

const getImageSrc = (img: string | { src: string }) => (typeof img === "string" ? img : img.src);
---

<section id="vertical-menu" class="vertical-menu" aria-label="Profile navigation" style={`--menu-hover-bg: url('${bgRight.src}')`}>
  <div class="avatar-ring mb-6">
    <img class="avatar" src={getImageSrc(aboutData.avatarUrl)} alt={`${aboutData.name} portrait`} loading="lazy" />
  </div>

  <div class="identity mt-2">
    <h1 class="name">{aboutData.name}</h1>
    <p class="role">{profileInfo.role}</p>
    <p class="headline">{profileInfo.headline}</p>
  </div>

  <nav class="menu" aria-label="Section links">
    {
      navItems.map((item) => (
        <a class="menu-link" href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <a class="cta" href={lang === "en" ? "src/assets/cv/EN_CV_JAFA.pdf" : "src/assets/cv/ES_CV_JAFA.pdf"}>
    {lang === "en" ? "Download Resume" : "Descargar Resumen"}
  </a>
</section>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const link = target.closest('a.menu-link[href^="#"]');
    if (!link) return;

    const href = link.getAttribute("href");
    if (href !== "#Experiencia") return;

    event.preventDefault();

    const section = document.querySelector("#Experiencia");
    if (!section) return;

    section.scrollIntoView({ behavior: "smooth", block: "start" });

    setTimeout(() => {
      const internal = document.querySelector("#experience-content");
      if (internal) internal.scrollTo({ top: 0, behavior: "smooth" });
    }, 350);

    history.replaceState(null, "", "#Experiencia");
  });
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600&family=Manrope:wght@400;500;600&display=swap");

  :global(:root) {
    --menu-shadow: 0 12px 30px var(--color-resaltar);
  }

  .vertical-menu {
    /* Cambio de width para que sea una columna real */
    width: 320px;
    /* Altura al 90% de su contenedor */
    height: 90%;

    /* Mantén tu gradiente y estilos, pero asegura que no flote */
    background: radial-gradient(120% 140% at 50% -10%, var(--bg-use) 0%, var(--bg-dark) 62%);
    border-radius: 28px;
    padding: 40px 28px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    box-shadow: var(--menu-shadow);
    border: 1px solid rgba(35, 44, 63, 0.08);
    position: relative;
    overflow: hidden;
    isolation: isolate;

    /* Evita que se encoja si el contenido crece */
    flex-shrink: 0;
  }

  .vertical-menu::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--menu-hover-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 0;
    pointer-events: none;
  }

  .vertical-menu:hover::before {
    opacity: 0.6;
  }

  .vertical-menu > * {
    position: relative;
    z-index: 1;
  }

  .avatar-ring {
    width: 120px;
    height: 120px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: conic-gradient(from 120deg, var(--bg-light), var(--bg-dark), var(--bg-use));
    padding: 6px;
  }

  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px;
    filter: grayscale(100%);
    border: 5px solid var(--bg-light);
    box-shadow: 0 10px 18px rgba(26, 34, 49, 0.18);
  }

  .avatar:hover,
  .avatar:focus-visible {
    filter: grayscale(0%);
    scale: 1.6;
    transition:
      transform 0.1s ease,
      filter 0.1s ease;
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .name {
    font-family: "Crimson Text", "Times New Roman", serif;
    font-size: 28px;
    color: var(--color-red);
    font-weight: 600;
    letter-spacing: 0.4px;
    margin: 0;
  }

  .role {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 18px;
    color: var(--color-purple);
    text-transform: uppercase;
    letter-spacing: 1.6px;
    margin: 0;
  }

  .headline {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .menu {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 6px;
    text-align: left;
    align-items: flex-start;
  }

  .menu-link {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 16px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .menu-link:hover {
    color: var(--color-green);
    transform: translateY(-1px);
  }

  .cta {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 12px 26px;
    background: var(--color-blue);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 12px 20px rgba(47, 109, 246, 0.25);
  }

  .footnote {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 11px;
    margin: 4px 0 0;
  }

  aside {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .vertical-menu {
      padding: 32px 22px 24px;
      gap: 18px;
    }
  }
</style>
