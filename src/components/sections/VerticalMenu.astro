---
import { aboutData } from "@/data/about";
import { Image } from "astro:assets";
import bgRight from "../../assets/images/bg_right.webp";
import bgLeft from "../../assets/images/bg_left.webp";
import alienIcon from "../../assets/logos/alien.svg";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "en" ? "en" : "es";

let profileInfo = null;
if (lang === "en") {
  profileInfo = aboutData.EN[0];
} else {
  profileInfo = aboutData.ES[0];
}

const navItems =
  lang === "en"
    ? [
        { label: "Home", href: "#Resumen" },
        { label: "Bio", href: "#Bio" },
        { label: "XP · Experience", href: "#Experiencia" },
        { label: "Side Quest · Projects", href: "#Proyectos" },
        { label: "Achievements · Certificates", href: "#Certificados" },
      ]
    : [
        { label: "Inicio", href: "#Resumen" },
        { label: "Bio", href: "#Bio" },
        { label: "XP · Experiencia", href: "#Experiencia" },
        { label: "Side Quest · Proyectos", href: "#Proyectos" },
        { label: "Logros · Certificados", href: "#Certificados" },
      ];
---

<section
  id="vertical-menu"
  class="vertical-menu"
  aria-label="Profile navigation"
  style={`--menu-hover-bg: url('${bgRight.src}'); --menu-bg: url('${bgLeft.src}')`}
>
  <div class="avatar-ring mb-6">
    <Image class="avatar" src={aboutData.avatarUrl} alt={`${aboutData.name} portrait`} loading="lazy" width={120} height={120} />
  </div>

  <div class="identity mt-2 mb-10">
    <h1 class="name">{aboutData.name}</h1>
    <p class="role">{profileInfo.role}</p>
    <p class="headline">{profileInfo.headline}</p>
  </div>

  <nav class="menu" aria-label="Section links">
    {
      navItems.map((item) => (
        <a class="menu-link flex items-center gap-2 group" href={item.href} data-section={item.href.replace("#", "")}>
          <div class="active-indicator opacity-0 transition-all duration-300 -translate-x-2">
            <Image src={alienIcon} alt="Active indicator" width={20} height={20} class="w-5 h-5 pointer-events-none" />
          </div>
          <span class="label-text transition-transform duration-300 group-hover:translate-x-1">{item.label}</span>
        </a>
      ))
    }
  </nav>

  <a class="cta mt-2" href={lang === "en" ? "/assets/cv/EN_CV_JAFA.pdf" : "/assets/cv/ES_CV_JAFA.pdf"} target="_blank" download>
    {lang === "en" ? "Download Resume" : "Descargar Resumen"}
  </a>
</section>

<script>
  // Smooth scroll logic previously here
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const link = target.closest('a.menu-link[href^="#"]');
    if (!link) return;

    const href = link.getAttribute("href");
    if (href !== "#Experiencia") return;

    event.preventDefault();

    const section = document.querySelector("#Experiencia");
    if (!section) return;

    section.scrollIntoView({ behavior: "smooth", block: "start" });

    setTimeout(() => {
      const internal = document.querySelector("#experience-content");
      if (internal) internal.scrollTo({ top: 0, behavior: "smooth" });
    }, 350);

    history.replaceState(null, "", "#Experiencia");
  });

  // Intersection Observer for active indicator
  const observerOptions = {
    root: null,
    rootMargin: "-20% 0px -70% 0px", // Focus on the upper-middle part of the viewport
    threshold: 0,
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        const indicators = document.querySelectorAll(".active-indicator");
        const links = document.querySelectorAll(".menu-link");

        // Use a flag to avoid multiple removals if unnecessary
        indicators.forEach((el) => {
          el.classList.remove("opacity-100", "translate-x-0");
          el.classList.add("opacity-0", "-translate-x-2");
        });

        links.forEach((l) => l.classList.remove("text-[var(--color-green)]"));

        const activeIndicator = document.querySelector(`.menu-link[data-section="${id}"] .active-indicator`);
        const activeLink = document.querySelector(`.menu-link[data-section="${id}"]`);

        if (activeIndicator) {
          activeIndicator.classList.remove("opacity-0", "-translate-x-2");
          activeIndicator.classList.add("opacity-100", "translate-x-0");
        }
        if (activeLink) {
          activeLink.classList.add("text-[var(--color-green)]");
        }
      }
    });
  }, observerOptions);

  // Observe all sections defined in navItems
  const navLinks = document.querySelectorAll(".menu-link");
  navLinks.forEach((link) => {
    const sectionId = link.getAttribute("data-section");
    if (sectionId) {
      const section = document.getElementById(sectionId);
      if (section) {
        observer.observe(section);
      }
    }
  });
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Crimson+Text:wght@400;600&family=Manrope:wght@400;500;600&display=swap");

  :global(:root) {
    --menu-shadow: 0 12px 30px var(--color-resaltar);
  }

  .vertical-menu {
    /* Cambio de width para que sea una columna real */
    width: 320px;
    /* Altura al 90% de su contenedor */
    height: 90%;

    /* Mantén tu gradiente y estilos, pero asegura que no flote */
    background: radial-gradient(120% 140% at 50% -10%, var(--bg-use) 0%, var(--bg-dark) 62%);
    border-radius: 28px;
    padding: 40px 28px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    position: relative;
    overflow: hidden;
    isolation: isolate;

    /* Evita que se encoja si el contenido crece */
    flex-shrink: 0;
  }

  .vertical-menu::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--menu-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.16;
    transition: opacity 0.25s ease;
    z-index: 0;
    pointer-events: none;
  }

  .vertical-menu::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--menu-hover-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 0;
    pointer-events: none;
  }

  .vertical-menu:hover {
    box-shadow: var(--menu-shadow);
    border: 1px solid rgba(35, 44, 63, 0.08);
  }

  .vertical-menu:hover::after {
    opacity: 0.2;
  }

  .vertical-menu:hover::before {
    opacity: 0;
  }

  .vertical-menu > * {
    position: relative;
    z-index: 1;
  }

  .avatar-ring {
    width: 120px;
    height: 120px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: conic-gradient(from 120deg, var(--bg-light), var(--bg-dark), var(--bg-use));
    padding: 6px;
  }

  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px;
    border: 5px solid var(--bg-light);
    box-shadow: 0 10px 18px rgba(26, 34, 49, 0.18);
  }

  .avatar:hover,
  .avatar:focus-visible {
    filter: grayscale(0%);
    scale: 1.6;
    transition:
      transform 0.1s ease,
      filter 0.1s ease;
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .name {
    font-family: "Crimson Text", "Times New Roman", serif;
    font-size: 28px;
    color: var(--color-green);
    font-weight: 600;
    letter-spacing: 0.4px;
    margin: 0;
  }

  .role {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 18px;
    color: var(--color-purple);
    text-transform: uppercase;
    letter-spacing: 1.6px;
    margin: 0;
  }

  .headline {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .menu {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 6px;
    text-align: left;
    align-items: stretch; /* Stretch to allow links to take full width */
  }

  .menu-link {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 16px;
    font-weight: bold;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s ease,
      color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    padding: 4px 0;
  }

  .active-indicator {
    flex-shrink: 0;
    width: 20px;
  }

  .menu-link:hover {
    color: var(--color-green);
    transform: translateX(4px);
  }

  .footnote {
    font-family: "Manrope", Arial, sans-serif;
    font-size: 11px;
    margin: 4px 0 0;
  }

  aside {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .vertical-menu {
      padding: 32px 22px 24px;
      gap: 18px;
    }
  }
</style>
