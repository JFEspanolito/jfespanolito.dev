---
import { Image } from "astro:assets";
import { aboutData } from "@/data/about";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang =
  typeof Astro.locals.lang === "string"
    ? Astro.locals.lang.toLowerCase()
    : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es"
    ? cookieLang
    : Astro.url.pathname.startsWith("/en")
      ? "en"
      : localLang === "en"
        ? "en"
        : "es";

let profile = null;
if (lang === "en") {
  profile = aboutData.EN[0];
} else {
  profile = aboutData.ES[0];
}

const contactInfo = [
  {
    name: "LinkedIn",
    url: aboutData.contact.find((c) => c.name === "LinkedIn")?.url,
    icon: aboutData.contact.find((c) => c.name === "LinkedIn")?.icon,
    desc:
      lang === "en"
        ? "Professional profile and updates"
        : "Perfil profesional y actualizaciones",
    label: lang === "en" ? "Let's talk on LinkedIn" : "Hablemos por LinkedIn",
    color: "var(--color-linkedin)",
    iconSymbol: "arrow_outward",
  },
  {
    name: "Telegram",
    url: aboutData.contact.find((c) => c.name === "Telegram")?.url,
    icon: aboutData.contact.find((c) => c.name === "Telegram")?.icon,
    desc:
      lang === "en"
        ? "Direct chat and quick responses"
        : "Chat directo y respuestas rápidas",
    label: lang === "en" ? "Message on Telegram" : "Mensaje en Telegram",
    color: "var(--color-telegram)",
    iconSymbol: "send",
  },
  {
    name: "Email",
    url: aboutData.contact.find((c) => c.name === "Email")?.url,
    icon: aboutData.contact.find((c) => c.name === "Email")?.icon,
    desc:
      lang === "en"
        ? "Formal inquiries and proposals"
        : "Consultas y propuestas formales",
    label: lang === "en" ? "Send Email" : "Enviar Correo",
    color: "var(--color-email)",
    iconSymbol: "forward_to_inbox",
  },
];
---

<section
  id="Bio"
  class="min-h-full w-full flex flex-col py-10 px-4 md:px-6 lg:px-8"
>
  <div
    class="relative w-full max-w-7xl mx-auto min-h-full text-[var(--color-green)]"
  >
    {
      lang === "en" ? (
        <h2 class="text-4xl font-bold mb-6">Biography</h2>
      ) : (
        <h2 class="text-4xl font-bold mb-6">Biografía</h2>
      )
    }

    <h2
      class="text-2xl md:text-3xl tracking-[0.2em] text-[var(--color-purple)] uppercase font-medium mb-6"
    >
      {profile.role}
    </h2>

    <p
      class="text-xl md:text-2xl text-[var(--color-resaltar)] font-medium mb-12"
    >
      {profile.headline}
    </p>

    <div class="space-y-8">
      {
        profile.description.map((paragraph) => (
          <p class="text-lg md:text-xl leading-relaxed text-gray-300">
            {paragraph.map((span) => (
              <span
                style={{
                  color: span.customColor || "inherit",
                  fontWeight: span.bold ? "700" : "400",
                }}
              >
                {span.text}
              </span>
            ))}
          </p>
        ))
      }
    </div>

    <!-- Conectemos Section -->
    <div class="mt-20 border-t border-white/10 pt-10">
      <div class="mb-8">
        <h3
          class="text-2xl font-bold text-white font-mono flex items-center gap-2 italic"
        >
          {profile.callToAction}
        </h3>
        <p class="text-gray-400 mt-2">
          {
            lang === "en"
              ? "Select your preferred communication channel to start a conversation."
              : "Selecciona tu canal de comunicación preferido para iniciar una conversación."
          }
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          contactInfo.map((contact) => (
            <a
              class="group relative bg-[var(--color-card-bg)] rounded-2xl p-8 border border-white/10 hover:border-[var(--color-blue)]/50 transition-all duration-300 hover:shadow-lg hover:shadow-[var(--color-blue)]/10 flex flex-col items-center text-center overflow-hidden"
              href={contact.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div
                class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-inner"
                style={`background-color: ${contact.color}20`}
              >
                <Image
                  src={contact.icon as any}
                  alt={contact.name}
                  class="w-10 h-10 opacity-90 group-hover:opacity-100 object-contain"
                  width={40}
                  height={40}
                />
              </div>

              <h4 class="text-xl font-bold text-white mb-2 group-hover:text-[var(--color-blue)] transition-colors">
                {contact.name}
              </h4>
              <p class="text-sm text-gray-400 mb-6">{contact.desc}</p>

              <span
                class="contact-btn mt-auto px-6 py-2 rounded-full border text-sm font-semibold transition-all duration-300 flex items-center gap-2"
                style={`border-color: ${contact.color}; color: ${contact.color}; --btn-color: ${contact.color};`}
              >
                {contact.label}
                <span class="material-symbols-outlined text-sm">
                  {contact.iconSymbol}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <style>
      .contact-btn:hover {
        background-color: var(--btn-color);
        color: white !important;
      }
    </style>
  </div>
</section>
