---
import { aboutData } from "@/data/about";

const lang = Astro.locals.lang ?? "es";
const key = lang.toUpperCase() as "ES" | "EN";
const profile = aboutData[key][0];
---

<section id="Bio" class="h-full min-h-0 w-full snap-start flex flex-col py-10 px-4 md:px-6 lg:px-8 overflow-hidden">
  <div class="relative w-full max-w-7xl mx-auto h-full min-h-0">
    <h2 class="text-4xl font-bold mb-8">Biografía</h2>
    <!-- <h1 class="text-3xl md:text-7xl font-bold text-white mb-8">
      {aboutData.name}
    </h1> -->

    <h2 class="text-2xl md:text-3xl tracking-[0.2em] text-[var(--color-purple)] uppercase font-medium mb-6">
      {profile.role}
    </h2>

    <p class="text-xl md:text-2xl text-[var(--color-blue-light)] font-medium mb-12">
      {profile.headline}
    </p>

    <div class="space-y-8">
      {
        profile.description.map((paragraph) => (
          <p class="text-lg md:text-xl leading-relaxed text-gray-300">
            {paragraph.map((span) => (
              <span
                style={{
                  color: span.customColor || "inherit",
                  fontWeight: span.bold ? "700" : "400",
                }}
              >
                {span.text}
              </span>
            ))}
          </p>
        ))
      }
    </div>
  </div>

  {/* Flecha de scroll */}
  <div class="absolute bottom-8 right-12">
    <div class="flex flex-col items-center gap-2 text-[var(--color-resaltar)] opacity-70">
      <span class="text-xs font-medium uppercase tracking-widest">Scroll</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--color-resaltar)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="animate-bounce"
      >
        <path d="M7 13l5 5 5-5M7 6l5 5 5-5"></path>
      </svg>
    </div>
  </div>
</section>
