---
import { aboutData } from "@/data/about";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang =
  typeof Astro.locals.lang === "string"
    ? Astro.locals.lang.toLowerCase()
    : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es"
    ? cookieLang
    : Astro.url.pathname.startsWith("/en")
      ? "en"
      : localLang === "en"
        ? "en"
        : "es";

let profile = null;
if (lang === "en") {
  profile = aboutData.EN[0];
} else {
  profile = aboutData.ES[0];
}
---

<section
  id="Bio"
  class="min-h-full w-full snap-start flex flex-col py-10 px-4 md:px-6 lg:px-8"
>
  <div
    class="relative w-full max-w-7xl mx-auto min-h-full text-[var(--color-green)]"
  >
    {
      lang === "en" ? (
        <h2 class="text-4xl font-bold mb-6">Biography</h2>
      ) : (
        <h2 class="text-4xl font-bold mb-6">Biografía</h2>
      )
    }
    <!-- <h1 class="text-3xl md:text-7xl font-bold text-white mb-8">
      {aboutData.name}
    </h1> -->

    <h2
      class="text-2xl md:text-3xl tracking-[0.2em] text-[var(--color-purple)] uppercase font-medium mb-6"
    >
      {profile.role}
    </h2>

    <p
      class="text-xl md:text-2xl text-[var(--color-resaltar)] font-medium mb-12"
    >
      {profile.headline}
    </p>

    <div class="space-y-8">
      {
        profile.description.map((paragraph) => (
          <p class="text-lg md:text-xl leading-relaxed text-gray-300">
            {paragraph.map((span) => (
              <span
                style={{
                  color: span.customColor || "inherit",
                  fontWeight: span.bold ? "700" : "400",
                }}
              >
                {span.text}
              </span>
            ))}
          </p>
        ))
      }
    </div>
  </div>
</section>
