---
import { Image } from "astro:assets";
import { aboutData } from "@/data/about";
import { useTranslations } from "@/i18n/ui";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "es" ? "es" : "en";

const t = useTranslations(lang);

let profile = null;
if (lang === "en") {
  profile = aboutData.EN[0];
} else {
  profile = aboutData.ES[0];
}
const emailAddress =
  aboutData.contact
    .find((c) => c.name === "Email")
    ?.url.replace(/^mailto:/, "")
    .split("?")[0] ?? "";
const workStack = [
  { key: "frontend", title: t("bio.stack.frontend"), items: aboutData.skillsAndTools.work.frontend },
  { key: "backend", title: t("bio.stack.backend"), items: aboutData.skillsAndTools.work.backend },
  { key: "automate", title: t("bio.stack.automate"), items: aboutData.skillsAndTools.work.automate },
  { key: "tools", title: t("bio.stack.tools"), items: aboutData.skillsAndTools.work.tools },
];
const gameStack = [
  { key: "skills", title: t("bio.stack.skills"), items: aboutData.skillsAndTools.indieGameDev.gamedesign },
  { key: "tools", title: t("bio.stack.tools"), items: aboutData.skillsAndTools.indieGameDev.tools },
];
const educationTitle = lang === "en" ? "Education" : "Educación";
const educationIntro =
  lang === "en"
    ? "Academic background, continuous learning, and the environments that shaped my technical foundation."
    : "Formación académica, aprendizaje continuo y los entornos que consolidaron mi base técnica.";
---

<section id="Bio" class="w-full flex flex-col py-12 px-4 md:px-6 lg:px-8">
  <div class="relative w-full max-w-7xl mx-auto min-h-full">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-green)] opacity-90 mb-2">
      {lang === "en" ? "Biography" : "Biografía"}
    </p>

    <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-8">
      {profile.role}
    </h2>

    {/* Description */}
    <div class="space-y-8 mb-12">
      {
        profile.description.map((paragraph) => (
          <p class="text-lg md:text-xl leading-relaxed text-gray-300">
            {paragraph.map((span) => (
              <span
                style={{
                  color: span.customColor || "inherit",
                  fontWeight: span.bold ? "700" : "400",
                }}
              >
                {span.text}
              </span>
            ))}
          </p>
        ))
      }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {/* col Left */}
      <div>
        {/* Tabs */}
        <div
          class="bio-card group relative overflow-hidden rounded-3xl border border-white/[0.08] bg-white/[0.02] p-6 md:p-8 backdrop-blur-sm shadow-xl transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04]"
        >
          {/* Pestañas */}
          <div
            class="flex w-full max-w-sm rounded-full border border-white/10 bg-white/[0.04] p-1 items-center justify-center mx-auto backdrop-blur-sm"
            role="tablist"
            aria-label={lang === "en" ? "Biography sections" : "Secciones de biografía"}
          >
            <button
              id="bio-tab-stack"
              type="button"
              class="bio-tab-trigger flex-1 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wider text-center transition-all text-slate-400"
              role="tab"
              aria-selected="true"
              aria-controls="bio-panel-stack"
              data-tab-target="bio-panel-stack"
            >
              {t("bio.tabs.stack")}
            </button>
            <button
              id="bio-tab-indieGameDev"
              type="button"
              class="bio-tab-trigger flex-1 rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wider text-center transition-all text-slate-400"
              role="tab"
              aria-selected="false"
              aria-controls="bio-panel-indieGameDev"
              data-tab-target="bio-panel-indieGameDev"
              tabindex="-1"
            >
              {t("bio.tabs.gamedev")}
            </button>
          </div>

          {/* Contenido */}
          <div class="mt-8">
            {/* Stack Laboral */}
            <div id="bio-panel-stack" class="bio-tab-panel" role="tabpanel" aria-labelledby="bio-tab-stack">
              <div class="mb-6">
                <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight mb-2">
                  {t("bio.stack")}
                </h3>
                <p class="text-sm leading-relaxed text-slate-300">
                  {
                    lang === "en"
                      ? "Technologies, tools, and practices I use to design, build, and scale professional software and automation solutions."
                      : "Tecnologías, herramientas y prácticas que utilizo para diseñar, desarrollar y escalar soluciones profesionales de software y automatización."
                  }
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
                {
                  workStack.map((group) => (
                    <div>
                      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-green)] opacity-90">{group.title}</p>
                      <div class="flex flex-wrap gap-1.5">
                        {group.items.map((item: string) => (
                          <span class="rounded-md bg-white/[0.04] px-2.5 py-1 text-xs font-medium text-slate-300">
                            {item}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            {/* Stack IndieGameDev */}
            <div id="bio-panel-indieGameDev" class="bio-tab-panel hidden" role="tabpanel" aria-labelledby="bio-tab-indieGameDev">
              <div class="mb-6">
                <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight mb-2">
                  {t("bio.gamedev")}
                </h3>
                <p class="text-sm leading-relaxed text-slate-300">
                  {
                    lang === "en"
                      ? "Design disciplines and tools I use to create tabletop game systems, mechanics, and worlds."
                      : "Disciplinas de diseño y herramientas que utilizo para crear sistemas, mecánicas y mundos de juegos de mesa."
                  }
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
                {
                  gameStack.map((group) => (
                    <div>
                      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-green)] opacity-90">{group.title}</p>
                      <div class="flex flex-wrap gap-1.5">
                        {group.items.map((item: string) => (
                          <span class="rounded-md bg-white/[0.04] px-2.5 py-1 text-xs font-medium text-slate-300">
                            {item}
                          </span>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
      {/* col Right */}
      <div>
        <div
          class="bio-card group relative overflow-hidden rounded-3xl border border-white/[0.08] bg-white/[0.02] p-6 md:p-8 backdrop-blur-sm shadow-xl transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04]"
        >
          <div class="relative z-10">
            <div class="mb-6">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-green)] opacity-90 mb-2">
                {lang === "en" ? "Academic Foundation" : "Fundamento Académico"}
              </p>
              <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight mb-2">
                {educationTitle}
              </h3>
              <p class="text-sm leading-relaxed text-slate-300">
                {educationIntro}
              </p>
            </div>

            <div class="space-y-6 pt-2">
              {
                profile.education.map((item, index) => (
                  <div>
                    <article>
                      <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
                        <div class="min-w-0">
                          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-green)] opacity-90">{item.institution}</p>
                          <h4 class="mt-1 text-xl font-bold leading-tight text-white">{item.degree}</h4>
                        </div>
                        <span class="text-xs font-mono font-medium text-slate-400 shrink-0">
                          {item.period}
                        </span>
                      </div>

                      <ul class="mt-4 space-y-2.5">
                        {item.notes.map((note) => (
                          <li class="flex gap-3 text-sm leading-relaxed text-slate-300">
                            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-green)] opacity-80" />
                            <span>{note}</span>
                          </li>
                        ))}
                      </ul>
                    </article>
                    {index < profile.education.length - 1 && <div class="mt-6 border-t border-white/[0.08]" />}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function copyEmailToClipboard(emailAddress: string) {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(emailAddress);
        return;
      }

      const input = document.createElement("textarea");
      input.value = emailAddress;
      input.setAttribute("readonly", "true");
      input.style.position = "absolute";
      input.style.left = "-9999px";
      document.body.appendChild(input);
      input.select();
      document.execCommand("copy");
      document.body.removeChild(input);
    }

    function initBioEmailLinks() {
      const emailCopies = document.querySelectorAll("[data-email-copy='true']");

      emailCopies.forEach((element) => {
        if (!(element instanceof HTMLElement) || element.dataset.bound === "true") return;

        element.dataset.bound = "true";
        element.addEventListener("click", async () => {
          const emailAddress = element.dataset.emailAddress ?? "";
          const copiedMessage = element.dataset.copiedMessage ?? "Correo copiado";
          const copyErrorMessage = element.dataset.copyErrorMessage ?? "No se pudo copiar el correo";

          try {
            await copyEmailToClipboard(emailAddress);
            document.dispatchEvent(
              new CustomEvent("sileo:notify", {
                detail: {
                  type: "success",
                  title: copiedMessage,
                  description: "",
                },
              })
            );
          } catch {
            document.dispatchEvent(
              new CustomEvent("sileo:notify", {
                detail: {
                  type: "error",
                  title: copyErrorMessage,
                  description: "",
                },
              })
            );
          }
        });
      });
    }

    function initBioTabs() {
      const triggers = Array.from(document.querySelectorAll(".bio-tab-trigger"));
      const panels = Array.from(document.querySelectorAll(".bio-tab-panel"));

      if (triggers.length === 0 || panels.length === 0) return;

      const activateTab = (targetId: string) => {
        triggers.forEach((trigger) => {
          if (!(trigger instanceof HTMLButtonElement)) return;

          const isActive = trigger.dataset.tabTarget === targetId;
          trigger.setAttribute("aria-selected", String(isActive));
          trigger.tabIndex = isActive ? 0 : -1;
          trigger.classList.toggle("bg-white/15", isActive);
          trigger.classList.toggle("text-white", isActive);
          trigger.classList.toggle("shadow-sm", isActive);
          trigger.classList.toggle("text-slate-400", !isActive);
        });

        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.classList.toggle("hidden", panel.id !== targetId);
        });
      };

      triggers.forEach((trigger, index) => {
        if (!(trigger instanceof HTMLButtonElement) || trigger.dataset.bound === "true") return;

        trigger.dataset.bound = "true";
        trigger.addEventListener("click", () => activateTab(trigger.dataset.tabTarget ?? "bio-panel-stack"));
        trigger.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;

          event.preventDefault();
          const nextIndex = event.key === "ArrowRight" ? (index + 1) % triggers.length : (index - 1 + triggers.length) % triggers.length;
          const nextTrigger = triggers[nextIndex];
          if (nextTrigger instanceof HTMLButtonElement) {
            nextTrigger.focus();
            activateTab(nextTrigger.dataset.tabTarget ?? "bio-panel-stack");
          }
        });
      });

      activateTab("bio-panel-stack");
    }

    initBioEmailLinks();
    initBioTabs();
    document.addEventListener("astro:page-load", initBioEmailLinks);
    document.addEventListener("astro:page-load", initBioTabs);
  </script>

  <style>
    .bio-card:hover {
      box-shadow: 0 28px 70px color-mix(in srgb, var(--color-resaltar) 16%, transparent);
    }

    .contact-btn:hover {
      background-color: var(--btn-color);
      color: white !important;
    }
  </style>
</section>
