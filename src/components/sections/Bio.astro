---
import { Image } from "astro:assets";
import { aboutData } from "@/data/about";
import { configProject as config } from "@/data/configProject";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "en" ? "en" : "es";

let profile = null;
if (lang === "en") {
  profile = aboutData.EN[0];
} else {
  profile = aboutData.ES[0];
}

const contactLinks = ((aboutData as any).contact ?? []) as Array<{
  name: string;
  url: string;
  icon: any;
}>;
---

<section id="Bio" class="min-h-full w-full snap-start flex flex-col py-10 px-4 md:px-6 lg:px-8">
  <div class="relative w-full max-w-7xl mx-auto min-h-full text-[var(--color-green)]">
    {lang === "en" ? <h2 class="text-4xl font-bold mb-6">Biography</h2> : <h2 class="text-4xl font-bold mb-6">Biografía</h2>}

    <h2 class="text-2xl md:text-3xl tracking-[0.2em] text-[var(--color-purple)] uppercase font-medium mb-6">
      {profile.role}
    </h2>

    <p class="text-xl md:text-2xl text-[var(--color-resaltar)] font-medium mb-12">
      {profile.headline}
    </p>

    <div class="space-y-8">
      {
        profile.description.map((paragraph) => (
          <p class="text-lg md:text-xl leading-relaxed text-gray-300">
            {paragraph.map((span) => (
              <span
                style={{
                  color: span.customColor || "inherit",
                  fontWeight: span.bold ? "700" : "400",
                }}
              >
                {span.text}
              </span>
            ))}
          </p>
        ))
      }
    </div>

    <div class="flex flex-wrap gap-2 items-center text-center mt-8">
      {
        contactLinks.map((contact) => (
          <a
            class="px-3 py-1 rounded-lg border border-[var(--color-purple)] bg-[var(--color-purple)] text-xs font-semibold text-[var(--color-resaltar)] hover:bg-[var(--color-resaltar)]"
            href={contact.url}
            title={`${contact.name}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${contact.name}`}
          >
            <Image
              class="w-8 h-8"
              src={contact.icon}
              alt={`${contact.name} icon`}
              width={32}
              height={32}
              loading="eager"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
