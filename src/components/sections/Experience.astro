---
import { experienceData } from "@/data/experience";
import FlipCard from "@/components/ui/FlipCard";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "en" ? "en" : "es";

let experiences = null;
if (lang === "en") {
  experiences = experienceData.EN;
} else {
  experiences = experienceData.ES;
}
---

<section id="Experiencia" class="min-h-screen w-full flex flex-col py-10 px-4 md:px-6 lg:px-8">
  <div class="w-full max-w-7xl mx-auto text-[var(--color-green)]">
    {lang === "en" ? <h2 class="text-4xl font-bold mb-6">XP · Experience</h2> : <h2 class="text-4xl font-bold mb-6">XP · Experiencia</h2>}
    <div id="experience-content" data-experience-scroll class="w-full flex flex-col gap-8 py-10">
      {
        experiences.map((exp) => {
          return (
            <div class="w-full flex justify-center">
              <div class="w-full">
                <FlipCard client:load experience={exp} />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
