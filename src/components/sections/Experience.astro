---
import { experienceData } from "@/data/experience";
import FlipCard from "@/components/ui/FlipCard";

const lang = Astro.locals.lang ?? "es";
const key = lang.toUpperCase() as "ES" | "EN";
const experiences = experienceData[key];

const nodeIcons = ["🤖", "💼", "💻", "⚙️"];
---

<section id="Experiencia" class="h-full min-h-0 w-full snap-start flex flex-col py-10 px-4 md:px-6 lg:px-8 overflow-hidden">
  <div class="relative w-full max-w-7xl mx-auto h-full min-h-0">
    {/* LÍNEA VERTICAL (Móvil) */}
    <div class="absolute left-5 top-0 w-[2px] h-full bg-white/20 z-0 md:hidden"></div>

    {/* LÍNEA VERTICAL (Desktop centrada) */}
    <div class="absolute left-1/2 -translate-x-1/2 top-0 w-[2px] h-full bg-white/20 z-0 hidden md:block"></div>

    <div id="experience-content" data-experience-scroll class="relative z-10 w-full h-full min-h-0 flex flex-col gap-12 py-10 overflow-y-auto no-scrollbar">
      {
        experiences.map((exp, index) => {
          const isLeft = index % 2 !== 0;

          return (
            <div class="group grid grid-cols-[auto_minmax(0,1fr)] md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-start gap-4 md:gap-0 w-full min-w-0">
              {/* NODO */}
              <div class="col-start-1 md:col-start-2 row-start-1 relative flex items-center justify-center w-10 md:w-12 h-10 md:h-12">
                <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-white border-2 border-white/30 flex items-center justify-center z-20 group-hover:border-[var(--color-resaltar)] transition-colors shadow-sm">
                  <span class="text-base md:text-lg">{nodeIcons[index] ?? "•"}</span>
                </div>

                {/* CONECTOR HORIZONTAL (solo desktop) */}
                <div
                  class:list={[
                    "hidden md:block absolute top-1/2 -translate-y-1/2 h-[2px] bg-white/20 z-10",
                    isLeft ? "right-1/2 w-8 lg:w-12" : "left-1/2 w-8 lg:w-12",
                  ]}
                />
              </div>

              {/* TARJETA */}
              <div
                class:list={[
                  "col-start-2 row-start-1 md:row-start-1 ml-2 md:ml-0 w-full min-w-0",
                  isLeft
                    ? "md:col-start-1 md:pr-10 lg:pr-14 md:justify-self-end"
                    : "md:col-start-3 md:pl-10 lg:pl-14 md:justify-self-start",
                ]}
              >
                <FlipCard client:load experience={exp} />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
  
  {/* Flecha de scroll */}
  <div class="absolute bottom-8 right-12">
    <div class="flex flex-col items-center gap-2 text-[var(--color-resaltar)] opacity-70">
      <span class="text-xs font-medium uppercase tracking-widest">Scroll</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--color-resaltar)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="animate-bounce"
      >
        <path d="M7 13l5 5 5-5M7 6l5 5 5-5"></path>
      </svg>
    </div>
  </div>
</section>
