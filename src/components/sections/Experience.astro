---
import { experienceData } from "@/data/experience";
import ExperienceCard from "@/components/ui/ExperienceCard";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "es" ? "es" : "en";

let experiences = null;
if (lang === "en") {
  experiences = experienceData.EN;
} else {
  experiences = experienceData.ES;
}

const introText =
  lang === "en"
    ? "A timeline of technical leadership, automation architecture, and engineering execution across enterprise environments."
    : "Una línea de tiempo de liderazgo técnico, arquitectura de automatización y ejecución de ingeniería en entornos empresariales.";

const activityLabel = lang === "en" ? "Key Contributions" : "Contribuciones Clave";
const stackLabel = lang === "en" ? "Primary Stack" : "Stack Principal";
---

<section id="Experiencia" class="w-full flex flex-col px-4 py-12 md:px-6 lg:px-8">
  <div class="w-full max-w-7xl mx-auto text-[#E6EDF3]">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-green)] opacity-90 mb-2">
        {lang === "en" ? "Track Record" : "Trayectoria"}
      </p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
        {lang === "en" ? "XP · Experience" : "XP · Experiencia"}
      </h2>
      <p class="mt-4 text-base md:text-lg leading-relaxed text-slate-300">{introText}</p>
    </div>

    <div id="experience-content" data-experience-scroll class="relative mt-10 w-full py-4">
      <div class="absolute bottom-0 left-[17px] top-0 w-px bg-gradient-to-b from-white/10 via-white/20 to-white/5 md:left-1/2 md:-translate-x-1/2"></div>

      <div class="flex flex-col gap-8 md:gap-10">
      {
        experiences.map((exp, index) => {
          const isEven = index % 2 === 0;

          return (
            <div class="relative grid grid-cols-[34px_minmax(0,1fr)] gap-4 md:grid-cols-[minmax(0,1fr)_88px_minmax(0,1fr)] md:gap-8 items-start">
              <div class="relative col-start-1 row-start-1 flex justify-center md:col-start-2">
                <div class="relative z-10 mt-8 h-3.5 w-3.5 rounded-full border-2 border-[#111524] bg-[var(--color-green)] shadow-[0_0_0_4px_rgba(159,243,194,0.15)]"></div>
              </div>

              <div
                class:list={[
                  "col-start-2 row-start-1 min-w-0",
                  isEven ? "md:col-start-1 md:pr-4" : "md:col-start-3 md:pl-4",
                ]}
              >
                <ExperienceCard experience={exp} activityLabel={activityLabel} stackLabel={stackLabel} />
              </div>
            </div>
          );
        })
      }
      </div>
    </div>
  </div>
</section>
