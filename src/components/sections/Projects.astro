---
import { projectsData } from "@/data/projects";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang =
  typeof Astro.locals.lang === "string"
    ? Astro.locals.lang.toLowerCase()
    : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es"
    ? cookieLang
    : Astro.url.pathname.startsWith("/en")
      ? "en"
      : localLang === "en"
        ? "en"
        : "es";

let projects = null;
if (lang === "en") {
  projects = projectsData.EN;
} else {
  projects = projectsData.ES;
}

const detailsLabel = lang === "en" ? "Details" : "Detalles";
const modalSkillsLabel = lang === "en" ? "Skills" : "Habilidades";
const closeLabel = lang === "en" ? "Close" : "Cerrar";

const projectsForModal = projects.map((project) => {
  const links = (project.link ?? []).map(
    (item: { label: string; url: string }) => ({
      label: item.label,
      url: item.url,
    }),
  );
  const githubLink =
    links.find(
      (item: { label: string; url: string }) =>
        /github/i.test(item.label) || /github\.com/i.test(item.url),
    )?.url ??
    ((project as any).github as string | undefined) ??
    "";

  return {
    id: String(project.id),
    title: project.title,
    status: project.status,
    description: project.description,
    image: project.image?.src ?? "",
    skills: project.skills ?? [],
    topskills: project.topskills ?? [],
    links,
    github: githubLink,
  };
});
---

<section
  id="Proyectos"
  class="w-full flex flex-col py-10 px-4 md:px-6 lg:px-8"
>
  <div class="relative w-full max-w-7xl mx-auto text-[var(--color-green)]">
    {
      lang === "en" ? (
        <h2 class="text-4xl font-bold mb-6">Side Quest · Projects</h2>
      ) : (
        <h2 class="text-4xl font-bold mb-6">
          Side Quest · Proyectos
        </h2>
      )
    }
  </div>

  <div
    class="relative w-full max-w-7xl mx-auto flex-1 min-h-0 text-[var(--text-use)] overflow-y-auto no-scrollbar pb-6"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[minmax(180px,auto)]"
    >
      {
        projects.map((project, index) => {
          const links = project.link ?? [];
          const visitLink = links[0]?.url ?? "";
          const githubLink =
            links.find(
              (item) =>
                /github/i.test(item.label) || /github\.com/i.test(item.url),
            )?.url ??
            ((project as any).github as string | undefined) ??
            "";
          const isFeatured = index === 0;

          return (
            <article
              class:list={[
                "relative overflow-hidden rounded-2xl border border-white/10 bg-[var(--bg-dark)]/50 hover:scale-[1.02] transition-transform",
                isFeatured
                  ? "md:col-span-8 md:row-span-2"
                  : "md:col-span-4 md:row-span-1",
              ]}
            >
              <div
                class="absolute inset-0 bg-cover opacity-60"
                style={`background-image: url('${project.image?.src ?? ""}'); ${project.imgBgPos ?? "background-position: 50% 130%;"}`}
              />

              <div class="relative z-10 h-full p-5 md:p-6 flex flex-col justify-between gap-4 ">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-2">
                  <span class="shrink-0 text-xs uppercase tracking-widest font-semibold bg-[var(--bg-use)] text-[var(--color-red)] border border-[var(--color-red)]/30 rounded-full px-3 py-1">
                    {project.status}
                  </span>

                  <div class="flex flex-wrap items-center gap-2 justify-end ml-auto">
                    {visitLink && (
                      <a
                        class="cta text-[var(--text-use)] hover:scale-[1.10] transition-transform border border-white/40"
                        href={visitLink}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {links[0]?.label ??
                          (lang === "en" ? "Visit" : "Visítala")}
                      </a>
                    )}

                    {githubLink && (
                      <a
                        class="cta text-[var(--text-use)] hover:scale-[1.10] transition-transform border border-white/40"
                        href={githubLink}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        GitHub
                      </a>
                    )}

                    <button
                      type="button"
                      class="cta text-[var(--text-use)] hover:scale-[1.10] transition-transform border border-white/40"
                      data-project-details={String(project.id)}
                    >
                      {detailsLabel}
                    </button>
                  </div>
                </div>

                <h3
                  class:list={[
                    "font-bold leading-tight text-[var(--color-green)] break-words",
                    isFeatured ? "text-3xl md:text-5xl" : "text-xl md:text-2xl",
                  ]}
                >
                  {project.title}
                </h3>

                <p
                  class:list={[
                    "text-[var(--text-use)] leading-relaxed",
                    isFeatured
                      ? "text-base md:text-lg line-clamp-4"
                      : "text-sm line-clamp-3",
                  ]}
                >
                  {project.description}
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>

  {/* Modal de detalles del proyecto */}
  <div
    id="project-details-modal"
    class="fixed inset-0 z-[120] hidden items-center justify-center bg-[var(--bg-dark)]/85 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Project details"
  >
    <div
      class="w-full max-w-3xl rounded-2xl border border-[var(--color-resaltar)]/40 bg-[var(--bg-dark)] p-6 md:p-8 shadow-xl"
    >
      <div class="flex items-start justify-between gap-4 mb-4">
        <div class="min-w-0">
          <h3
            id="project-modal-title"
            class="text-2xl md:text-3xl font-bold text-[var(--text-use)]"
          >
          </h3>
          <p
            id="project-modal-status"
            class="mt-2 inline-flex text-xs uppercase tracking-widest font-semibold text-[var(--color-red)] bg-[var(--color-red)]/10 border border-[var(--color-red)]/30 rounded-full px-3 py-1"
          >
          </p>
        </div>

        <button
          id="project-modal-close"
          type="button"
          class="h-9 w-9 rounded-full border border-white/20 text-[var(--text-use)] hover:border-[var(--color-resaltar)]"
          aria-label={closeLabel}>✕</button
        >
      </div>

      <div
        class="mb-5 rounded-xl overflow-hidden border border-white/10 bg-black/10"
      >
        <img
          id="project-modal-image"
          src=""
          alt=""
          class="w-full h-auto max-h-[320px] object-cover"
        />
      </div>

      <p id="project-modal-description" class="text-base leading-relaxed"></p>

      <div class="mt-5">
        <p
          class="text-xs uppercase tracking-widest font-semibold mb-2 text-[var(--color-blue)]"
        >
          {modalSkillsLabel}
        </p>
        <div id="project-modal-skills" class="flex flex-wrap gap-2"></div>
      </div>

      <div id="project-modal-actions" class="mt-6 flex flex-wrap gap-2"></div>
    </div>
  </div>
</section>

<script define:vars={{ projectsForModal, detailsLabel, closeLabel }}>
  const projectsMap = new Map(
    projectsForModal.map((project) => [String(project.id), project]),
  );

  const modal = document.getElementById("project-details-modal");
  const closeBtn = document.getElementById("project-modal-close");
  const titleEl = document.getElementById("project-modal-title");
  const statusEl = document.getElementById("project-modal-status");
  const imageEl = document.getElementById("project-modal-image");
  const descriptionEl = document.getElementById("project-modal-description");
  const skillsEl = document.getElementById("project-modal-skills");
  const actionsEl = document.getElementById("project-modal-actions");

  function closeProjectModal() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  function openProjectModal(projectId) {
    const project = projectsMap.get(String(projectId));
    if (
      !project ||
      !modal ||
      !titleEl ||
      !statusEl ||
      !imageEl ||
      !descriptionEl ||
      !skillsEl ||
      !actionsEl
    )
      return;

    titleEl.textContent = project.title || "Project";
    statusEl.textContent = project.status || "";
    imageEl.src = project.image || "";
    imageEl.alt = project.title || "Project";
    descriptionEl.textContent = project.description || "";

    skillsEl.innerHTML = "";
    (project.topskills || []).forEach((topskill) => {
      const chip = document.createElement("span");
      chip.className =
        "px-3 py-1 rounded-lg border border-[var(--color-purple)]/30 bg-[var(--color-purple)]/10 text-xs font-semibold text-[var(--color-resaltar)]";
      chip.textContent = topskill;
      skillsEl.appendChild(chip);
    });

    (project.skills || []).forEach((skill) => {
      const chip = document.createElement("span");
      chip.className =
        "px-3 py-1 rounded-lg border border-[var(--color-purple)]/30 bg-[var(--color-purple)]/10 text-xs font-semibold text-[var(--color-resaltar)]";
      chip.textContent = skill;
      skillsEl.appendChild(chip);
    });

    actionsEl.innerHTML = "";
    (project.links || []).forEach((link) => {
      if (!link?.url) return;
      const anchor = document.createElement("a");
      anchor.href = link.url;
      anchor.target = "_blank";
      anchor.rel = "noopener noreferrer";
      anchor.className = "cta text-[var(--text-use)]";
      anchor.textContent = link.label || detailsLabel || "Visit";
      actionsEl.appendChild(anchor);
    });

    if (project.github) {
      const github = document.createElement("a");
      github.href = project.github;
      github.target = "_blank";
      github.rel = "noopener noreferrer";
      github.className =
        "text-xs uppercase tracking-wide font-semibold px-3 py-2 rounded-full border border-[var(--color-purple)]/40 text-[var(--color-purple)] hover:bg-[var(--color-purple)]/10";
      github.textContent = "GitHub";
      actionsEl.appendChild(github);
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  document.querySelectorAll("[data-project-details]").forEach((button) => {
    button.addEventListener("click", () => {
      openProjectModal(button.getAttribute("data-project-details"));
    });
  });

  closeBtn?.addEventListener("click", closeProjectModal);

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeProjectModal();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeProjectModal();
  });
</script>
