---
import { projectsData } from "@/data/projects";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es"
    ? cookieLang
    : Astro.url.pathname.startsWith("/en")
      ? "en"
      : localLang === "en"
        ? "en"
        : "es";

let projects = null;
if (lang === "en") {
  projects = projectsData.EN;
} else {
  projects = projectsData.ES;
}
---

<section id="Proyectos" class="h-full min-h-0 w-full snap-start flex flex-col py-10 px-4 md:px-6 lg:px-8 overflow-hidden">
  <div class="relative w-full max-w-7xl mx-auto h-full min-h-0 text-[var(--color-green)]">
    {lang === "en" ? <h2 class="text-4xl font-bold mb-6">Projects</h2> : <h2 class="text-4xl font-bold mb-6">Proyectos</h2>}
  </div>

  {/* Flecha de scroll */}
  <div class="absolute bottom-8 right-12">
    <div class="flex flex-col items-center gap-2 text-[var(--color-resaltar)] opacity-70">
      <span class="text-xs font-medium uppercase tracking-widest">Scroll</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--color-resaltar)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="animate-bounce"
      >
        <path d="M7 13l5 5 5-5M7 6l5 5 5-5"></path>
      </svg>
    </div>
  </div>
</section>
