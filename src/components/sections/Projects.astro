---
import { projectsData } from "@/data/projects";

const cookieLang = Astro.cookies.get("lang")?.value?.trim().toLowerCase();
const localLang = typeof Astro.locals.lang === "string" ? Astro.locals.lang.toLowerCase() : undefined;

const lang: "es" | "en" =
  cookieLang === "en" || cookieLang === "es" ? cookieLang : Astro.url.pathname.startsWith("/en") ? "en" : localLang === "en" ? "en" : "es";

const projects = lang === "en" ? projectsData.EN : projectsData.ES;

const sectionTitle = lang === "en" ? "Side Quest · Projects" : "Side Quest · Proyectos";
const detailsLabel = lang === "en" ? "Details" : "Detalles";
const visitLabel = lang === "en" ? "Visit" : "Visitar";
const modalSkillsLabel = lang === "en" ? "Skills" : "Habilidades";
const closeLabel = lang === "en" ? "Close" : "Cerrar";

function getBackgroundPosition(imgBgPos?: string) {
  if (!imgBgPos) return "50% 50%";
  const match = imgBgPos.match(/background-position\s*:\s*([^;]+)\s*;?/i);
  return (match?.[1] ?? "50% 50%").trim();
}

function getStatusBadgeClass(status?: string) {
  const value = (status ?? "").trim().toLowerCase();
  const isDev = value === "in development" || value === "en desarrollo";
  return isDev
    ? "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/30"
    : "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30";
}

const [featuredProject, ...restProjects] = projects;

const featuredLinks = featuredProject?.link ?? [];
const featuredVisitLink = featuredLinks[0]?.url ?? "";
const featuredBgPosition = getBackgroundPosition(featuredProject?.imgBgPos);

const projectsForModal = projects.map((project) => {
  const links = (project.link ?? []).map((item: { label: string; url: string }) => ({
    label: item.label,
    url: item.url,
  }));
  const githubLink =
    links.find((item: { label: string; url: string }) => /github/i.test(item.label) || /github\.com/i.test(item.url))?.url ??
    ((project as any).github as string | undefined) ??
    "";

  return {
    id: String(project.id),
    title: project.title,
    status: project.status,
    description: project.description,
    image: project.image?.src ?? "",
    skills: project.skills ?? [],
    topskills: project.topskills ?? [],
    links,
    github: githubLink,
  };
});
---

<section id="Proyectos" class="w-full flex flex-col py-10 px-4 md:px-6 lg:px-8">
  <div class="relative w-full max-w-7xl mx-auto">
    <h2 class="text-4xl font-bold mb-8 text-[var(--color-green)]">{sectionTitle}</h2>

    {/* ── Featured Project ─────────────────────────────────────────── */}
    {
      featuredProject && (
        <article
          class="project-hover-card group relative w-full overflow-hidden rounded-2xl border border-[#2A3B5F] bg-[#121A2B] mb-8
               transition-all duration-300
            hover:border-[#38BDF8]/40"
        >
          {/* Image + gradient overlay */}
          <div class="relative h-[320px] md:h-[460px] overflow-hidden">
            <div
              class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              style={`background-image: url('${featuredProject.image?.src ?? ""}'); background-size: cover; background-repeat: no-repeat; background-position: ${featuredBgPosition};`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] via-[#0B1120]/50 to-transparent" />
            <div class="absolute inset-0 bg-gradient-to-r from-[#0B1120]/70 via-[#0B1120]/20 to-transparent" />

            {/* Content on top of image */}
            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 lg:p-10">
              <span class={getStatusBadgeClass(featuredProject.status)}>{featuredProject.status}</span>

              <h3 class="mt-3 text-3xl md:text-5xl font-bold text-[#E6EDF3] leading-tight tracking-tight">{featuredProject.title}</h3>

              <p class="mt-3 text-[#9FB0C3] text-sm md:text-base leading-relaxed max-w-2xl line-clamp-3">{featuredProject.description}</p>

              {/* Tech tags */}
              {featuredProject.topskills && featuredProject.topskills.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {featuredProject.topskills.map((skill: string) => (
                    <span class="bg-[#1E293B] text-[#9FB0C3] text-xs px-2 py-1 rounded">{skill}</span>
                  ))}
                </div>
              )}

              {/* Actions */}
              <div class="flex flex-wrap gap-3 mt-5">
                {featuredVisitLink && (
                  <a
                    href={featuredVisitLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-hover-primary inline-flex items-center px-5 py-2.5 rounded-xl bg-[#38BDF8] text-[#0B1120] text-sm font-semibold
                         transition-all duration-200
                      hover:bg-[#38BDF8]/90"
                  >
                    {featuredLinks[0]?.label ?? visitLabel}
                  </a>
                )}
                <button
                  type="button"
                  data-project-details={String(featuredProject.id)}
                  class="inline-flex items-center px-5 py-2.5 rounded-xl border border-[#2A3B5F] text-[#E6EDF3] text-sm font-medium
                       transition-all duration-200
                       hover:border-[#38BDF8]/50 hover:text-[#38BDF8]"
                >
                  {detailsLabel}
                </button>
              </div>
            </div>
          </div>
        </article>
      )
    }

    {/* ── Projects Grid ─────────────────────────────────────────────── */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        restProjects.map((project) => {
          const links = project.link ?? [];
          const visitLink = links[0]?.url ?? "";
          const bgPosition = getBackgroundPosition(project.imgBgPos);

          return (
            <article
              class="project-hover-card group flex flex-col overflow-hidden rounded-2xl border border-[#2A3B5F] bg-[#121A2B]
                     transition-all duration-300
                hover:border-[#38BDF8]/35 hover:-translate-y-1"
            >
              {/* Image */}
              <div class="relative h-[180px] overflow-hidden shrink-0">
                <div
                  class="absolute inset-0 transition-transform duration-500 ease-out group-hover:scale-[1.06]"
                  style={`background-image: url('${project.image?.src ?? ""}'); background-size: cover; background-repeat: no-repeat; background-position: ${bgPosition};`}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#121A2B] via-transparent to-transparent" />
              </div>

              {/* Content */}
              <div class="flex flex-col flex-1 p-5 gap-3">
                {/* Title + badge */}
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-[#E6EDF3] text-lg font-bold leading-snug">{project.title}</h3>
                  <span class:list={[getStatusBadgeClass(project.status), "shrink-0 mt-0.5"]}>{project.status}</span>
                </div>

                {/* Description */}
                <p class="text-[#9FB0C3] text-sm leading-relaxed line-clamp-3 flex-1">{project.description}</p>

                {/* Tech tags */}
                {project.topskills && project.topskills.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {project.topskills.map((skill: string) => (
                      <span class="bg-[#1E293B] text-[#9FB0C3] text-xs px-2 py-1 rounded">{skill}</span>
                    ))}
                  </div>
                )}

                {/* Actions */}
                <div class="flex flex-wrap gap-2 pt-1 mt-auto">
                  {visitLink && (
                    <a
                      href={visitLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center px-4 py-2 rounded-lg bg-[#38BDF8]/10 text-[#38BDF8] text-xs font-semibold border border-[#38BDF8]/20
                             transition-all duration-200
                             hover:bg-[#38BDF8]/20 hover:border-[#38BDF8]/40"
                    >
                      {links[0]?.label ?? visitLabel}
                    </a>
                  )}
                  <button
                    type="button"
                    data-project-details={String(project.id)}
                    class="inline-flex items-center px-4 py-2 rounded-lg border border-[#2A3B5F] text-[#9FB0C3] text-xs font-medium
                           transition-all duration-200
                           hover:border-[#8B5CF6]/40 hover:text-[#8B5CF6]"
                  >
                    {detailsLabel}
                  </button>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>

  {/* ── Details Modal ─────────────────────────────────────────────── */}
  <div
    id="project-details-modal"
    class="fixed inset-0 z-[120] hidden items-center justify-center bg-[#0B1120]/90 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Project details"
  >
    <div class="w-full max-w-3xl rounded-2xl border border-[#2A3B5F] bg-[#121A2B] p-6 md:p-8 shadow-2xl">
      <div class="flex items-start justify-between gap-4 mb-4">
        <div class="min-w-0">
          <h3 id="project-modal-title" class="text-2xl md:text-3xl font-bold text-[#E6EDF3]"></h3>
          <p id="project-modal-status" class="mt-2"></p>
        </div>
        <button
          id="project-modal-close"
          type="button"
          class="shrink-0 h-9 w-9 rounded-full border border-[#2A3B5F] text-[#9FB0C3]
                 transition-all duration-200
                 hover:border-[#38BDF8]/50 hover:text-[#38BDF8]"
          aria-label={closeLabel}>✕</button
        >
      </div>

      <div class="mb-5 rounded-xl overflow-hidden border border-[#2A3B5F]">
        <img id="project-modal-image" src="" alt="" class="w-full h-auto max-h-[320px] object-cover" />
      </div>

      <p id="project-modal-description" class="text-[#9FB0C3] text-base leading-relaxed"></p>

      <div class="mt-5">
        <p class="text-xs uppercase tracking-widest font-semibold mb-3 text-[#38BDF8]">
          {modalSkillsLabel}
        </p>
        <div id="project-modal-skills" class="flex flex-wrap gap-2"></div>
      </div>

      <div id="project-modal-actions" class="mt-6 flex flex-wrap gap-3"></div>
    </div>
  </div>
</section>

<script define:vars={{ projectsForModal, detailsLabel, visitLabel, closeLabel }}>
  const projectsMap = new Map(projectsForModal.map((project) => [String(project.id), project]));

  const modal = document.getElementById("project-details-modal");
  const closeBtn = document.getElementById("project-modal-close");
  const titleEl = document.getElementById("project-modal-title");
  const statusEl = document.getElementById("project-modal-status");
  const imageEl = document.getElementById("project-modal-image");
  const descriptionEl = document.getElementById("project-modal-description");
  const skillsEl = document.getElementById("project-modal-skills");
  const actionsEl = document.getElementById("project-modal-actions");

  function getStatusBadgeClass(value) {
    const normalized = String(value || "")
      .trim()
      .toLowerCase();
    const isDev = normalized === "in development" || normalized === "en desarrollo";
    return isDev
      ? "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/30"
      : "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30";
  }

  function closeProjectModal() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function openProjectModal(projectId) {
    const project = projectsMap.get(String(projectId));
    if (!project || !modal || !titleEl || !statusEl || !imageEl || !descriptionEl || !skillsEl || !actionsEl) return;

    titleEl.textContent = project.title || "Project";
    statusEl.textContent = project.status || "";
    statusEl.className = `mt-2 ${getStatusBadgeClass(project.status)}`;
    imageEl.src = project.image || "";
    imageEl.alt = project.title || "Project";
    descriptionEl.textContent = project.description || "";

    skillsEl.innerHTML = "";
    [...(project.topskills || []), ...(project.skills || [])].forEach((skill) => {
      const chip = document.createElement("span");
      chip.className = "bg-[#1E293B] text-[#9FB0C3] text-xs px-2.5 py-1 rounded border border-[#2A3B5F]";
      chip.textContent = skill;
      skillsEl.appendChild(chip);
    });

    actionsEl.innerHTML = "";
    (project.links || []).forEach((link) => {
      if (!link?.url) return;
      const anchor = document.createElement("a");
      anchor.href = link.url;
      anchor.target = "_blank";
      anchor.rel = "noopener noreferrer";
      anchor.className =
        "project-hover-primary inline-flex items-center px-5 py-2.5 rounded-xl bg-[#38BDF8] text-[#0B1120] text-sm font-semibold transition-all duration-200 hover:bg-[#38BDF8]/90";
      anchor.textContent = link.label || visitLabel || "Visit";
      actionsEl.appendChild(anchor);
    });

    if (project.github) {
      const github = document.createElement("a");
      github.href = project.github;
      github.target = "_blank";
      github.rel = "noopener noreferrer";
      github.className =
        "inline-flex items-center px-5 py-2.5 rounded-xl border border-[#8B5CF6]/40 text-[#8B5CF6] text-sm font-medium transition-all duration-200 hover:bg-[#8B5CF6]/10 hover:border-[#8B5CF6]/60";
      github.textContent = "GitHub";
      actionsEl.appendChild(github);
    }

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  document.querySelectorAll("[data-project-details]").forEach((button) => {
    button.addEventListener("click", () => {
      openProjectModal(button.getAttribute("data-project-details"));
    });
  });

  closeBtn?.addEventListener("click", closeProjectModal);

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeProjectModal();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeProjectModal();
  });
</script>

<style>
  .project-hover-card:hover {
    box-shadow: 0 8px 32px color-mix(in srgb, var(--color-resaltar) 12%, transparent);
  }

  .project-hover-primary:hover {
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-resaltar) 35%, transparent);
  }
</style>
